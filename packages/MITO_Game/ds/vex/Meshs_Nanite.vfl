// VEX Code for 08.02.Meshs_Nanite HDA
string H = ".."; // HDA 相对路径
// ========== 通用工具函数 ==========
void ensure_attr(string owner; string aname; string type)
{
    if (owner == "point")
    {
        if (type == "string" && !haspointattrib(0, aname)) addpointattrib(0, aname, "");
        else if (type == "int" && !haspointattrib(0, aname)) addpointattrib(0, aname, 0);
        else if (type == "float" && !haspointattrib(0, aname)) addpointattrib(0, aname, 0.0);
    }
    else if (owner == "prim")
    {
        if (type == "string" && !hasprimattrib(0, aname)) addprimattrib(0, aname, "");
        else if (type == "int" && !hasprimattrib(0, aname)) addprimattrib(0, aname, 0);
        else if (type == "float" && !hasprimattrib(0, aname)) addprimattrib(0, aname, 0.0);
    }
    else if (owner == "vertex")
    {
        if (type == "string" && !hasvertexattrib(0, aname)) addvertexattrib(0, aname, "");
        else if (type == "int" && !hasvertexattrib(0, aname)) addvertexattrib(0, aname, 0);
        else if (type == "float" && !hasvertexattrib(0, aname)) addvertexattrib(0, aname, 0.0);
    }
    else
    {
        if (type == "string" && !hasdetailattrib(0, aname)) adddetailattrib(0, aname, "");
        else if (type == "int" && !hasdetailattrib(0, aname)) adddetailattrib(0, aname, 0);
        else if (type == "float" && !hasdetailattrib(0, aname)) adddetailattrib(0, aname, 0.0);
    }
}
void set_val(string owner; string aname; string type; string sval)
{
    if (type == "string")
    {
        if (owner == "point") { int np=npoints(0); for(int i=0;i<np;i++) setpointattrib(0, aname, i, sval, "set"); }
        else if (owner == "prim"){ int np=nprimitives(0); for(int i=0;i<np;i++) setprimattrib(0, aname, i, sval, "set"); }
        else if (owner == "vertex"){ int np=nprimitives(0); for(int p=0;p<np;p++){ int nv = primvertexcount(0, p); for(int v=0;v<nv;v++){ setvertexattrib(0, aname, p, v, sval, "set"); }} }
        else setdetailattrib(0, aname, sval, "set");
    }
    else if (type == "int")
    {
        int v_int = atoi(sval);
        if (owner == "point") { int np=npoints(0); for(int i=0;i<np;i++) setpointattrib(0, aname, i, v_int, "set"); }
        else if (owner == "prim"){ int np=nprimitives(0); for(int i=0;i<np;i++) setprimattrib(0, aname, i, v_int, "set"); }
        else if (owner == "vertex"){ int np=nprimitives(0); for(int p=0;p<np;p++){ int nv = primvertexcount(0, p); for(int v=0;v<nv;v++){ setvertexattrib(0, aname, p, v, v_int, "set"); }} }
        else setdetailattrib(0, aname, v_int, "set");
    }
    else
    {
        float v_float = atof(sval);
        if (owner == "point") { int np=npoints(0); for(int i=0;i<np;i++) setpointattrib(0, aname, i, v_float, "set"); }
        else if (owner == "prim"){ int np=nprimitives(0); for(int i=0;i<np;i++) setprimattrib(0, aname, i, v_float, "set"); }
        else if (owner == "vertex"){ int np=nprimitives(0); for(int p=0;p<np;p++){ int nv = primvertexcount(0, p); for(int v=0;v<nv;v++){ setvertexattrib(0, aname, p, v, v_float, "set"); }} }
        else setdetailattrib(0, aname, v_float, "set");
    }
}
void write_int(string owner; string aname; int v)
{
    ensure_attr(owner, aname, "int");
    set_val(owner, aname, "int", itoa(v));
}
void write_float(string owner; string aname; float v)
{
    ensure_attr(owner, aname, "float");
    set_val(owner, aname, "float", sprintf("%g", v));
}
void write_str(string owner; string aname; string v)
{
    ensure_attr(owner, aname, "string");
    set_val(owner, aname, "string", v);
}
// ========== 处理 08.02.Meshs_Nanite.ds 中的参数 ==========
// --- Nanite Position Precision ---
if (chi(H + "/en_nanite_position_precision"))
{
    string owner = chs(H + "/owner_nanite_position_precision");
    string mode = chs(H + "/form_mode_nanite_position_precision");
    string attr_name = "unreal_nanite_position_precision";
    if (mode == "attrib")
    {
        string from_attr = chs(H + "/nanite_position_precision_from");
        ensure_attr(owner, attr_name, "int");
        if (owner == "point")
        {
            int np = npoints(0);
            for(int i=0; i<np; i++)
            {
                int from_val = point(0, from_attr, i);
                setpointattrib(0, attr_name, i, from_val, "set");
            }
        }
        else if (owner == "prim")
        {
            int np = nprimitives(0);
            for(int i=0; i<np; i++)
            {
                int from_val = prim(0, from_attr, i);
                setprimattrib(0, attr_name, i, from_val, "set");
            }
        }
        else if (owner == "vertex")
        {
            int np = nprimitives(0);
            for(int p=0; p<np; p++)
            {
                int nv = primvertexcount(0, p);
                for(int v=0; v<nv; v++)
                {
                    int from_val = vertex(0, from_attr, p, v);
                    setvertexattrib(0, attr_name, p, v, from_val, "set");
                }
            }
        }
        else
        {
            int from_val = detail(0, from_attr, 0);
            setdetailattrib(0, attr_name, from_val, "set");
        }
    }
    else
    {
        int v = chi(H + "/nanite_position_precision_val");
        write_int(owner, attr_name, v);
    }
}
