            if (owner=="point"){
                int n = npoints(0);
                for (int i=0;i<n;i++){ int vv = int(point(0, src, i)); setpointattrib(0, an, i, vv, "set"); }
            }else if (owner=="vertex"){
                int nv = nvertices(0);
                for (int vid=0; vid<nv; vid++){
                    int pr  = vertexprim(0, vid);
                    int vtx = vertexprimindex(0, vid);
                    int vv = int(vertex(0, src, vid));
