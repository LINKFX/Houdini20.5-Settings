// VEX Code for 05.04.Landscape_SplineControlPoint
string H = "..";

// ---------- 工具 ----------
void _clear_other_owners(string owner; string an)
{
    if (owner != "point"  && haspointattrib(0,  an)) removeattrib(0, "point",  an);
    if (owner != "prim"   && hasprimattrib(0,   an)) removeattrib(0, "prim",   an);
    if (owner != "vertex" && hasvertexattrib(0, an)) removeattrib(0, "vertex", an);
    if (owner != "detail" && hasdetailattrib(0, an)) removeattrib(0, "detail", an);
}
void _remove_all_owners(string an)
{
    if (haspointattrib(0,  an)) removeattrib(0, "point",  an);
    if (hasprimattrib(0,   an)) removeattrib(0, "prim",   an);
    if (hasvertexattrib(0, an)) removeattrib(0, "vertex", an);
    if (hasdetailattrib(0, an)) removeattrib(0, "detail", an);
}

// 广播（仅用于 value 模式）
void _broadcast_str(string owner; string an; string v){
    if (owner=="point"){ int n=npoints(0); for(int i=0;i<n;i++) setpointattrib(0,an,i,v,"set"); }
    else if (owner=="prim"){ int n=nprimitives(0); for(int i=0;i<n;i++) setprimattrib(0,an,i,v,"set"); }
    else if (owner=="vertex"){ int nv=nvertices(0); for(int vid=0;vid<nv;vid++){ int pr=vertexprim(0,vid); int vtx=vertexprimindex(0,vid); setvertexattrib(0,an,pr,vtx,v,"set"); } }
    else setdetailattrib(0,an,v,"set");
}
void _broadcast_int(string owner; string an; int v){
    if (owner=="point"){ int n=npoints(0); for(int i=0;i<n;i++) setpointattrib(0,an,i,v,"set"); }
    else if (owner=="prim"){ int n=nprimitives(0); for(int i=0;i<n;i++) setprimattrib(0,an,i,v,"set"); }
    else if (owner=="vertex"){ int nv=nvertices(0); for(int vid=0;vid<nv;vid++){ int pr=vertexprim(0,vid); int vtx=vertexprimindex(0,vid); setvertexattrib(0,an,pr,vtx,v,"set"); } }
    else setdetailattrib(0,an,v,"set");
}
void _broadcast_f(string owner; string an; float v){
    if (owner=="point"){ int n=npoints(0); for(int i=0;i<n;i++) setpointattrib(0,an,i,v,"set"); }
    else if (owner=="prim"){ int n=nprimitives(0); for(int i=0;i<n;i++) setprimattrib(0,an,i,v,"set"); }
    else if (owner=="vertex"){ int nv=nvertices(0); for(int vid=0;vid<nv;vid++){ int pr=vertexprim(0,vid); int vtx=vertexprimindex(0,vid); setvertexattrib(0,an,pr,vtx,v,"set"); } }
    else setdetailattrib(0,an,v,"set");
}
void _broadcast_v3(string owner; string an; vector v){
    if (owner=="point"){ int n=npoints(0); for(int i=0;i<n;i++) setpointattrib(0,an,i,v,"set"); }
    else if (owner=="prim"){ int n=nprimitives(0); for(int i=0;i<n;i++) setprimattrib(0,an,i,v,"set"); }
    else if (owner=="vertex"){ int nv=nvertices(0); for(int vid=0;vid<nv;vid++){ int pr=vertexprim(0,vid); int vtx=vertexprimindex(0,vid); setvertexattrib(0,an,pr,vtx,v,"set"); } }
    else setdetailattrib(0,an,v,"set");
}

// ==========================================================
// A) Rotation (vector)  -> rot
// ==========================================================
{
    string an = "rot";
    int on = chi(H + "/en_rot");
    if (!on) _remove_all_owners(an);
    else{
        string owner = chs(H + "/owner_rot");
        string mode  = chs(H + "/form_mode_rot");
        _clear_other_owners(owner, an);

        if (mode=="attrib"){
            string src = chs(H + "/rot_from");
            if (owner=="point"){
                int n = npoints(0);
                for (int i=0;i<n;i++){ vector vv = point(0, src, i); setpointattrib(0, an, i, vv, "set"); }
            }else if (owner=="vertex"){
                int nv = nvertices(0);
                for (int vid=0; vid<nv; vid++){
                    int pr  = vertexprim(0, vid);
                    int vtx = vertexprimindex(0, vid);
                    vector vv = vertex(0, src, vid);
                    setvertexattrib(0, an, pr, vtx, vv, "set");
                }
            }
        }else{
            vector v = chv(H + "/rot_val");
            _broadcast_v3(owner, an, v);
        }
    }
}

