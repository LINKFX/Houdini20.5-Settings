// VEX Code for 04.Instancers HDA

string H = "..";

// --- unreal_instance ---
if (chi(H + "/en_inst_instance")) {
    string owner = chs(H + "/owner_inst_instance");
    string mode = chs(H + "/form_mode_inst_instance");
    string attr_name = "unreal_instance";
    if (mode == "attrib") {
        string from_attr = chs(H + "/inst_instance_from");
        if (owner == "point") {
            int np = npoints(0);
            for(int i=0; i<np; i++) {
                string from_val = point(0, from_attr, i);
                setpointattrib(0, attr_name, i, from_val, "set");
            }
        } else if (owner == "prim") {
            int np = nprimitives(0);
            for(int i=0; i<np; i++) {
                string from_val = prim(0, from_attr, i);
                setprimattrib(0, attr_name, i, from_val, "set");
            }
        } else if (owner == "detail") {
            string from_val = detail(0, from_attr, 0);
            setdetailattrib(0, attr_name, from_val, "set");
        }
    } else {
        string u = chs(H + "/inst_instance_val");
        if (owner == "point") {
            int np = npoints(0);
            for(int i=0; i<np; i++) {
                setpointattrib(0, attr_name, i, u, "set");
            }
        } else if (owner == "prim") {
            int np = nprimitives(0);
            for(int i=0; i<np; i++) {
                setprimattrib(0, attr_name, i, u, "set");
            }
        } else if (owner == "detail") {
            setdetailattrib(0, attr_name, u, "set");
        }
    }
}

