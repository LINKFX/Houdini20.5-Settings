{
    name	selectedparms

    groupsimple {
        name    "folder7"
        label   "Root Folder"
        grouptag { "sidefx::look" "blank" }

        parm {
            name    "target_landscape_name"
            label   "Landscape"
            type    ordinal
            default { "Landscape" }
            menu {
                "Landscape" "Landscape"
            }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "run_mode"
            label   "Run Mode"
            type    ordinal
            default { "0" }
            menu {
                "0" "Unset"
                "1" "Cache"
                "2" "Load"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "create_input_node"
            label   "Auto Create Input Node"
            type    button
            default { "0" }
            help    "根据输入端名称，自动创建Null节点"
            parmtag { "button_icon" "" }
            parmtag { "script_callback" "hou.phm().create_input_nulls(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "create_output_node"
            label   "Auto Create Output Node"
            type    button
            default { "0" }
            help    "根据输出端名称，自动创建Null节点"
            parmtag { "button_icon" "" }
            parmtag { "script_callback" "hou.phm().create_output_nulls(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "preview"
            label   "Preview"
            type    toggle
            default { "1" }
            parmtag { "script_callback_language" "python" }
        }
        group {
            name    "folder10"
            label   "Landscape Settings"

            group {
                name    "folder11"
                label   "Landscape Cache To UE"
                disablewhentab "{ run_mode != 1 }"
                parmtag { "group_default" "1" }
                grouptag { "sidefx::switcher" "folder4" }

                groupcollapsible {
                    name    "height_layers"
                    label   "—————Height Layers———————————————————————"
                    grouptag { "sidefx::switcher" "height_layers" }

                    parm {
                        name    "load_all_caches"
                        label   "Load All Caches"
                        type    button
                        joinnext
                        default { "0" }
                        parmtag { "script_callback" "hou.phm().load_all_caches(kwargs)" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "uninstall_all_caches"
                        label   "Uninstall All Caches"
                        type    button
                        default { "0" }
                        parmtag { "script_callback" "hou.phm().uninstall_all_caches(kwargs)" }
                        parmtag { "script_callback_language" "python" }
                    }
                    groupcollapsible {
                        name    "folder13"
                        label   "Export Layers To Unreal"
                        grouptag { "sidefx::switcher" "folder0" }

                        groupsimple {
                            name    "folder0"
                            label   "Base Layer"
                            grouptag { "sidefx::look" "blank" }

                            parm {
                                name    "cache_layer_name_1"
                                label   "Layers Name"
                                type    ordinal
                                nolabel
                                joinnext
                                default { "0" }
                                disablewhen "{ target_landscape_name != -1 }"
                                menu {
                                    "Base_Layer"        "Base_Layer"
                                    "Macrol_Layer"      "Macrol_Layer"
                                    "Procedural_Layer"  "Procedural_Layer"
                                    "Manual_Layer"      "Manual_Layer"
                                    "Splines_Layer"     "Splines_Layer"
                                    "Material_Layer"    "Material_Layer"
                                    "Splines"           "Splines"
                                }
                                parmtag { "script_callback_language" "python" }
                            }
                            parm {
                                name    "as_1"
                                label   "As"
                                type    label
                                nolabel
                                joinnext
                                default { "As" }
                            }
                            parm {
                                name    "update_layer_name_1"
                                label   "Layer Name"
                                type    ordinal
                                nolabel
                                joinnext
                                default { "0" }
                                menu {
                                    "Base_Layer"        "Base_Layer"
                                    "Macrol_Layer"      "Macrol_Layer"
                                    "Procedural_Layer"  "Procedural_Layer"
                                    "Manual_Layer"      "Manual_Layer"
                                    "Splines_Layer"     "Splines_Layer"
                                    "Material_Layer"    "Material_Layer"
                                    "Splines"           "Splines"
                                }
                                parmtag { "script_callback_language" "python" }
                            }
                            parm {
                                name    "output_mode_1"
                                label   "Output Mode"
                                type    integer
                                nolabel
                                joinnext
                                default { "1" }
                                menu {
                                    "0" "Create New"
                                    "1" "Only Update Layer"
                                }
                                range   { 0 10 }
                                parmtag { "autoscope" "0000000000000000" }
                                parmtag { "script_callback_language" "python" }
                            }
                            parm {
                                name    "lock_layer_1"
                                label   "Lock Layer"
                                type    toggle
                                joinnext
                                default { "1" }
                                range   { 0 10 }
                                parmtag { "autoscope" "0000000000000000" }
                                parmtag { "script_callback_language" "python" }
                            }
                            parm {
                                name    "save_layer_1"
                                label   "Save Layer"
                                type    button
                                joinnext
                                default { "0" }
                                range   { 0 1 }
                                parmtag { "autoscope" "0000000000000000" }
                                parmtag { "script_callback_language" "python" }
                                parmtag { "takecontrol" "always" }
                            }
                            parm {
                                name    "reload_1"
                                label   "Reload Geometry"
                                type    button
                                joinnext
                                default { "0" }
                                range   { 0 1 }
                                parmtag { "autoscope" "0000000000000000" }
                            }
                            parm {
                                name    "cache_to_ue_load_1"
                                label   "Load from Disk"
                                type    toggle
                                joinnext
                                default { "off" }
                                range   { 0 1 }
                                parmtag { "autoscope" "0000000000000000" }
                            }
                            parm {
                                name    "display_path_1"
                                label   "Display Path"
                                type    toggle
                                joinnext
                                default { "0" }
                                parmtag { "script_callback_language" "python" }
                            }
                            parm {
                                name    "sepparm14"
                                label   "Spacer"
                                type    separator
                                default { "" }
                                parmtag { "sidefx::layout_height" "small" }
                                parmtag { "sidefx::look" "blank" }
                            }
                            parm {
                                name    "to_unreal_path1"
                                label   "Path"
                                type    geometry
                                default { "$ASSETS_PATH/Environments/Landscape/TO_UNREAL/`chs(\"cache_layer_name_1\")`_To_Unreal.bgeo.sc" }
                                hidewhen "{ display_path_1 == 0 }"
                                menureplace {
                                    [ "opmenu -l -a filecache3 file" ]
                                }
                                range   { 0 1 }
                                parmtag { "autoscope" "0000000000000000" }
                                parmtag { "filechooser_mode" "write" }
                                parmtag { "sidefx::header_toggle" "display_path" }
                            }
                        }

                        groupsimple {
                            name    "folder1"
                            label   "Macrol Layer"
                            grouptag { "sidefx::look" "blank" }

                            parm {
