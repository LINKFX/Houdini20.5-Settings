        }
        parm {
            name    "cp_form_mode_endfalloff"
            label   "CP Form Mode"
            type    ordinal
            nolabel
            default { "value" }
            disablewhen "{ en_cp_endfalloff == 0 }"
            menu {
                "attrib"    "Attribute"
                "value"     "Value"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "cp_endfalloff_from_pt"
            label   "Attribute From"
            type    string
            default { "" }
            disablewhen "{ en_cp_endfalloff == 0 } { owner_cp_endfalloff != point } { cp_form_mode_endfalloff != attrib }"
            hidewhen "{ owner_cp_endfalloff != point }"
            menutoggle { [ " opmenu -l -a attribute ptdel " ] }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "cp_endfalloff_from_vtx"
            label   "Attribute From"
            type    string
            default { "" }
            disablewhen "{ en_cp_endfalloff == 0 } { owner_cp_endfalloff != vertex } { cp_form_mode_endfalloff != attrib }"
            hidewhen "{ owner_cp_endfalloff != vertex }"
            menutoggle { [ " opmenu -l -a attribute vtxdel " ] }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "cp_endfalloff_val"
            label   "Falloff"
            type    float
            default { "256.0" }
            disablewhen "{ en_cp_endfalloff == 0 } { cp_form_mode_endfalloff != value }"
            range   { 0! 10000 }
            parmtag { "script_callback_language" "python" }
        }
    }

