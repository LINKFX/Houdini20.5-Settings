{
    name	selectedparms

    group {
        name    "folder3_1"
        label   "Splines_General"
        parmtag { "group_default" "0" }
        grouptag { "import_enable" "1" }
        grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.Landscape.ds" }
        grouptag { "import_token" "folder3:Splines_Segment" }

        parm {
            name    "en_ls_spline"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.02.Landscape_SplinesGeneral.ds" }
            parmtag { "import_token" "en_ls_spline" }
            parmtag { "script_callback_language" "python" }
        }
        groupcollapsible {
            name    "grp_ls_spline"
            label   "Landscape Spline"
            parmtag { "group_default" "0" }
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.02.Landscape_SplinesGeneral.ds" }
            grouptag { "import_token" "grp_ls_spline:Landscape Spline" }
            parmtag { "sidefx::header_toggle" "en_ls_spline" }

            parm {
                name    "ls_spline_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_spline" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.02.Landscape_SplinesGeneral.ds" }
                parmtag { "import_token" "ls_spline_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "ls_spline_help"
                label   "Help"
                type    label
                default { "说明：设为 1 使插件将曲线原语识别为 Landscape Splines。\n示例：1 → 写出 unreal_landscape_spline=1。\n结果：后续曲线作为 Landscape Spline 参与生成/应用。\nOwner：Point/Vertex/Prim/Detail。" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.02.Landscape_SplinesGeneral.ds" }
                parmtag { "import_token" "ls_spline_help" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_ls_spline"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                default { "prim" }
                disablewhen "{ en_ls_spline == 0 }"
                menu {
                    "point"     "Point"
                    "vertex"    "Vertex"
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.02.Landscape_SplinesGeneral.ds" }
                parmtag { "import_token" "owner_ls_spline" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_ls_target"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.02.Landscape_SplinesGeneral.ds" }
            parmtag { "import_token" "en_ls_target" }
            parmtag { "script_callback_language" "python" }
        }
        groupcollapsible {
            name    "grp_ls_target"
            label   "Target Landscape"
            parmtag { "group_default" "0" }
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.02.Landscape_SplinesGeneral.ds" }
            grouptag { "import_token" "grp_ls_target:Target Landscape" }
            parmtag { "sidefx::header_parm" "ls_target_str" }
            parmtag { "sidefx::header_toggle" "en_ls_target" }

            parm {
                name    "ls_target_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_spline_target_landscape" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.02.Landscape_SplinesGeneral.ds" }
                parmtag { "import_token" "ls_target_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "ls_target_help"
                label   "Help"
                type    label
                default { "说明：指定用于创建样条的目标 Landscape。可设为 InputX(0,1,…) 指向 HDA 的某个输入 Landscape。\n示例：Input0 → 写出 unreal_landscape_spline_target_landscape=Input0。\n结果：样条会应用到所选 Landscape。\nOwner：Prim。" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.02.Landscape_SplinesGeneral.ds" }
                parmtag { "import_token" "ls_target_help" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_ls_target"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_ls_target == 0 }"
                menu {
                    "prim"  "Prim"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.02.Landscape_SplinesGeneral.ds" }
                parmtag { "import_token" "owner_ls_target" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "form_mode_ls_target_str"
                label   "Form Mode"
                type    ordinal
                nolabel
                default { "value" }
                menu {
                    "attrib"    "Attribute"
                    "value"     "Value"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.02.Landscape_SplinesGeneral.ds" }
                parmtag { "import_token" "form_mode_ls_target_str" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "ls_target_str_from"
                label   "Attribute From"
                type    string
                default { "" }
                disablewhen "{ form_mode_ls_target_str != attrib }"
                menureplace {
                    [ "node = hou.pwd()" ]
                    [ "owner = node.parm(\"owner_ls_target\").evalAsString()" ]
                    [ "" ]
                    [ "in_node = node.node(\"IN\")" ]
                    [ "if not in_node:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "geo = in_node.geometry()" ]
                    [ "attrs = []" ]
                    [ "" ]
                    [ "if owner == \"point\":" ]
                    [ "    attrs = [a.name() for a in geo.pointAttribs()]" ]
                    [ "elif owner == \"prim\":" ]
                    [ "    attrs = [a.name() for a in geo.primAttribs()]" ]
                    [ "elif owner == \"vertex\":" ]
                    [ "    attrs = [a.name() for a in geo.vertexAttribs()]" ]
                    [ "elif owner == \"detail\":" ]
                    [ "    attrs = [a.name() for a in geo.globalAttribs()]" ]
                    [ "" ]
                    [ "menu = []" ]
                    [ "for a in attrs:" ]
                    [ "    menu += [a, a]" ]
                    [ "" ]
                    [ "return menu" ]
                    language python
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.02.Landscape_SplinesGeneral.ds" }
                parmtag { "import_token" "ls_target_str_from" }
                parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'owner_ls_target')" }
                parmtag { "menu_script_language" "python" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "ls_target_str"
                label   "Landscape Name"
                type    string
                default { "Landscape" }
                disablewhen "{ en_ls_target == 0 } { form_mode_ls_target_str != value }"
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.02.Landscape_SplinesGeneral.ds" }
                parmtag { "import_token" "ls_target_str" }
                parmtag { "script_callback_language" "python" }
            }
        }

    }


}