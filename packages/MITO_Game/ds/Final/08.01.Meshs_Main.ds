{
    name	selectedparms

    group {
        name    "folder0"
        label   "Main"
        grouptag { "import_enable" "1" }
        grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }

        parm {
            name    "mesh_main_en_unreal_lightmap_resolution"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }
            parmtag { "import_token" "mesh_main_en_unreal_lightmap_resolution" }
            parmtag { "script_callback_language" "python" }
        }
        groupcollapsible {
            name    "mesh_main_grp_unreal_lightmap_resolution"
            label   "Lightmap Resolution"
            parmtag { "group_default" "0" }
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }
            grouptag { "import_token" "mesh_main_grp_unreal_lightmap_resolution:Lightmap Resolution" }
            parmtag { "sidefx::header_toggle" "mesh_main_en_unreal_lightmap_resolution" }

            parm {
                name    "mesh_main_unreal_lightmap_resolution_heading"
                label   "Heading"
                type    label
                default { "unreal_lightmap_resolution" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }
                parmtag { "import_token" "mesh_main_unreal_lightmap_resolution_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "mesh_main_unreal_lightmap_resolution_help"
                label   "Help"
                type    label
                default { "说明：设置网格组件的光照贴图分辨率。可通过Attribute或直接输入值。\n示例(Attribute)：来源attr=128 → 写出unreal_lightmap_resolution=128。\n示例(数值)：直接输入64 → UE中应用该分辨率。\n结果：影响网格的光照质量。\nOwner：Point/Primitive/Vertex/Detail." }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }
                parmtag { "import_token" "mesh_main_unreal_lightmap_resolution_help" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "mesh_main_owner_unreal_lightmap_resolution"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "point" }
                disablewhen "{ mesh_main_en_unreal_lightmap_resolution == 0 }"
                menu {
                    "point"     "Point"
                    "prim"      "Primitive"
                    "vertex"    "Vertex"
                    "detail"    "Detail"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }
                parmtag { "import_token" "mesh_main_owner_unreal_lightmap_resolution" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "mesh_main_form_mode_unreal_lightmap_resolution"
                label   "Form Mode"
                type    ordinal
                nolabel
                default { "value" }
                disablewhen "{ mesh_main_en_unreal_lightmap_resolution == 0 }"
                menu {
                    "attrib"    "Attribute"
                    "value"     "Value"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }
                parmtag { "import_token" "mesh_main_form_mode_unreal_lightmap_resolution" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "mesh_main_unreal_lightmap_resolution_from"
                label   "Attribute From"
                type    string
                default { "unreal_lightmap_resolution" }
                disablewhen "{ mesh_main_en_unreal_lightmap_resolution == 0 } { mesh_main_form_mode_unreal_lightmap_resolution != attrib }"
                menureplace {
                    [ "node = hou.pwd()" ]
                    [ "owner = node.parm(\"mesh_main_owner_unreal_lightmap_resolution\").evalAsString()" ]
                    [ "" ]
                    [ "in_node = node.node(\"IN\")" ]
                    [ "if not in_node:" ]
                    [ " return []" ]
                    [ "" ]
                    [ "geo = in_node.geometry()" ]
                    [ "attrs = []" ]
                    [ "" ]
                    [ "if owner == \"point\":" ]
                    [ " attrs = [a.name() for a in geo.pointAttribs()]" ]
                    [ "elif owner == \"prim\":" ]
                    [ " attrs = [a.name() for a in geo.primAttribs()]" ]
                    [ "elif owner == \"vertex\":" ]
                    [ " attrs = [a.name() for a in geo.vertexAttribs()]" ]
                    [ "elif owner == \"detail\":" ]
                    [ " attrs = [a.name() for a in geo.globalAttribs()]" ]
                    [ "" ]
                    [ "menu_items = []" ]
                    [ "for a in attrs:" ]
                    [ " menu_items += [a, a]" ]
                    [ "" ]
                    [ "return menu_items" ]
                    language python
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }
                parmtag { "import_token" "mesh_main_unreal_lightmap_resolution_from" }
                parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'mesh_main_owner_unreal_lightmap_resolution')" }
                parmtag { "menu_script_language" "python" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "mesh_main_unreal_lightmap_resolution_val"
                label   "Lightmap Resolution"
                type    integer
                default { "64" }
                disablewhen "{ mesh_main_en_unreal_lightmap_resolution == 0 } { mesh_main_form_mode_unreal_lightmap_resolution != value }"
                range   { 0 10 }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }
                parmtag { "import_token" "mesh_main_unreal_lightmap_resolution_val" }
                parmtag { "script_callback_language" "python" }
            }
        }

