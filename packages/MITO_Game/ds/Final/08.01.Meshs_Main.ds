                parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'mesh_main_owner_unreal_nanite_position_precision')" }
                parmtag { "menu_script_language" "python" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
