                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "mesh_main_unreal_disable_gamma_correction_help"
                label   "Help"
                type    label
                default { "说明：如果不为0，则在读取'Cd'属性时不执行伽马校正。适用于Meshes。可通过Attribute或直接输入。\n示例(Attribute)：来源attr=1 → 写出unreal_disable_gamma_correction=1。\n示例(数值)：直接输入0 → UE中启用伽马校正。\n结果：控制颜色读取行为。\nOwner：Point/Primitive/Vertex/Detail." }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }
                parmtag { "import_token" "mesh_main_unreal_disable_gamma_correction_help" }
