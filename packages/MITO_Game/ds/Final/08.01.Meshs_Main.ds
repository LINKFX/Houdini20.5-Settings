                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }
                parmtag { "import_token" "mesh_main_unreal_nanite_position_precision_val" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "mesh_main_en_unreal_nanite_percent_triangles"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }
            parmtag { "import_token" "mesh_main_en_unreal_nanite_percent_triangles" }
            parmtag { "script_callback_language" "python" }
        }
        groupcollapsible {
            name    "mesh_main_grp_unreal_nanite_percent_triangles"
            label   "Nanite Percent Triangles"
            parmtag { "group_default" "0" }
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }
            grouptag { "import_token" "mesh_main_grp_unreal_nanite_percent_triangles:Nanite Percent Triangles" }
            parmtag { "sidefx::header_toggle" "mesh_main_en_unreal_nanite_percent_triangles" }

            parm {
                name    "mesh_main_unreal_nanite_percent_triangles_heading"
                label   "Heading"
                type    label
                default { "unreal_nanite_percent_triangles" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }
                parmtag { "import_token" "mesh_main_unreal_nanite_percent_triangles_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "mesh_main_unreal_nanite_percent_triangles_help"
                label   "Help"
                type    label
                default { "说明：设置Nanite网格保留三角形的百分比，默认0（无三角形）（UE5）。可通过Attribute或直接输入。\n示例(Attribute)：来源attr=50 → 写出unreal_nanite_percent_triangles=50。\n示例(数值)：直接输入0 → UE中使用默认设置。\n结果：控制Nanite网格的简化。\nOwner：Point/Primitive/Vertex/Detail." }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }
                parmtag { "import_token" "mesh_main_unreal_nanite_percent_triangles_help" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "mesh_main_owner_unreal_nanite_percent_triangles"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "point" }
                disablewhen "{ mesh_main_en_unreal_nanite_percent_triangles == 0 }"
                menu {
                    "point"     "Point"
                    "prim"      "Primitive"
                    "vertex"    "Vertex"
                    "detail"    "Detail"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }
                parmtag { "import_token" "mesh_main_owner_unreal_nanite_percent_triangles" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "mesh_main_form_mode_unreal_nanite_percent_triangles"
                label   "Form Mode"
                type    ordinal
                nolabel
                default { "value" }
                disablewhen "{ mesh_main_en_unreal_nanite_percent_triangles == 0 }"
                menu {
                    "attrib"    "Attribute"
                    "value"     "Value"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }
                parmtag { "import_token" "mesh_main_form_mode_unreal_nanite_percent_triangles" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "mesh_main_unreal_nanite_percent_triangles_from"
                label   "Attribute From"
                type    string
                default { "unreal_nanite_percent_triangles" }
                disablewhen "{ mesh_main_en_unreal_nanite_percent_triangles == 0 } { mesh_main_form_mode_unreal_nanite_percent_triangles != attrib }"
                menureplace {
                    [ "node = hou.pwd()" ]
                    [ "owner = node.parm(\"mesh_main_owner_unreal_nanite_percent_triangles\").evalAsString()" ]
                    [ "" ]
                    [ "in_node = node.node(\"IN\")" ]
                    [ "if not in_node:" ]
                    [ " return []" ]
                    [ "" ]
                    [ "geo = in_node.geometry()" ]
                    [ "attrs = []" ]
                    [ "" ]
                    [ "if owner == \"point\":" ]
                    [ " attrs = [a.name() for a in geo.pointAttribs()]" ]
                    [ "elif owner == \"prim\":" ]
                    [ " attrs = [a.name() for a in geo.primAttribs()]" ]
                    [ "elif owner == \"vertex\":" ]
                    [ " attrs = [a.name() for a in geo.vertexAttribs()]" ]
                    [ "elif owner == \"detail\":" ]
                    [ " attrs = [a.name() for a in geo.globalAttribs()]" ]
                    [ "" ]
                    [ "menu_items = []" ]
                    [ "for a in attrs:" ]
                    [ " menu_items += [a, a]" ]
                    [ "" ]
                    [ "return menu_items" ]
                    language python
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }
                parmtag { "import_token" "mesh_main_unreal_nanite_percent_triangles_from" }
                parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'mesh_main_owner_unreal_nanite_percent_triangles')" }
                parmtag { "menu_script_language" "python" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "mesh_main_unreal_nanite_percent_triangles_val"
                label   "Nanite Percent Triangles"
                type    integer
                default { "0" }
                disablewhen "{ mesh_main_en_unreal_nanite_percent_triangles == 0 } { mesh_main_form_mode_unreal_nanite_percent_triangles != value }"
                range   { 0 10 }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.01.Meshs_Main.ds" }
                parmtag { "import_token" "mesh_main_unreal_nanite_percent_triangles_val" }
                parmtag { "script_callback_language" "python" }
            }
        }

