    group {
        name    "folder_meshes_2"
        label   "Sockets"
        tabbreak
        grouptag { "import_enable" "1" }
        grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.03.Meshs_Sockets.ds" }

        parm {
            name    "en_mesh_socket"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.03.Meshs_Sockets.ds" }
            parmtag { "import_token" "en_mesh_socket" }
            parmtag { "script_callback_language" "python" }
        }
        groupcollapsible {
            name    "folder6"
            label   "Mesh Sockets"
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.03.Meshs_Sockets.ds" }
            grouptag { "import_token" "folder6:Mesh Sockets" }
            parmtag { "sidefx::header_toggle" "en_mesh_socket" }

            parm {
                name    "mesh_socket_help"
                label   "Help"
                type    label
                default { "说明：定义 Mesh 的多个 Socket（位置、旋转、缩放、名称、标签、附着 Actor）。通过 multiparm 可添加任意数量。\n示例(Attribute)：来源 mesh_socket0_pos=(0,50,100)，mesh_socket0_name=Grip → 写出 UE 中 Socket Grip 位置(0,50,100)。\n示例(Value)：直接输入 Position=(0,0,100)，Name=WeaponSocket → UE 中生成名为 WeaponSocket 的 Socket。\n结果：Bake 后 Static Mesh 在 UE 中自动生成对应数量的 Socket，每个带有设定的变换和可选 Actor/Tag，用于蓝图或运行时附着。\nOwner：Detail。" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.03.Meshs_Sockets.ds" }
                parmtag { "import_token" "mesh_socket_help" }
                parmtag { "sidefx::look" "heading" }
            }
            multiparm {
                name    "num_sockets"
                label    "Number of Mesh Sockets"
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.03.Meshs_Sockets.ds" }
                parmtag { "import_token" "num_sockets" }

                parm {
                    name    "en_socket#"
                    label   "Enable Socket #"
                    type    toggle
                    default { "1" }
                    parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.03.Meshs_Sockets.ds" }
                    parmtag { "import_token" "en_socket#" }
                    parmtag { "script_callback_language" "python" }
                }
                groupcollapsible {
                    name    "grp_socket#"
                    label   "Socket #"
                    grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.03.Meshs_Sockets.ds" }
                    grouptag { "import_token" "grp_socket#:Socket #" }
                    parmtag { "sidefx::header_toggle" "en_socket#" }

                    parm {
                        name    "mode_socket#"
                        label   "Mode"
                        type    ordinal
                        default { "value" }
                        disablewhen "{ en_socket# == 0 }"
                        menu {
                            "attrib"    "Attribute"
                            "value"     "Value"
                        }
                        parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/08.03.Meshs_Sockets.ds" }
                        parmtag { "import_token" "mode_socket#" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "socket_pos_from#"
                        label   "Attribute Position"
                        type    string
                        default { "mesh_socket#_pos" }
                        disablewhen "{ en_socket# == 0 } { mode_socket# != attrib }"
                        menureplace {
                            [ "node = hou.pwd()" ]
                            [ "in_node = node.node(\"IN\")" ]
                            [ "if not in_node:" ]
                            [ "    return []" ]
                            [ "geo = in_node.geometry()" ]
                            [ "attrs = [a.name() for a in geo.globalAttribs()]" ]
                            [ "menu = []" ]
                            [ "for a in attrs:" ]
                            [ "    menu += [a, a]" ]
                            [ "return menu" ]
