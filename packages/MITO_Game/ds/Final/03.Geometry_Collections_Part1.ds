    parm {
        name    "gc_min_level_set_resolution_enable"
        label   "Min Level Set Resolution"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    groupcollapsible {
        name    "grp_gc_min_level_set_resolution"
        label   "Min Level Set Resolution"
        parmtag { "group_default" "0" }
        parmtag { "sidefx::header_toggle" "gc_min_level_set_resolution_enable" }

        parm {
            name    "gc_min_level_set_resolution_heading"
            label   "Heading"
            type    label
            default { "unreal_gc_collisions_min_level_set_resolution_X" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "gc_min_level_set_resolution_help"
            label   "Help"
            type    label
            default { "说明：指定碰撞的最小水平集分辨率。X 指定大小特定数据的索引。\n示例(Attribute)：unreal_gc_collisions_min_level_set_resolution_0=5\n示例(Value)：5\n结果：控制碰撞网格的分辨率。\nOwner：Int。" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "owner_gc_min_level_set_resolution"
            label   "Attribute Owner"
            type    ordinal
            nolabel
            joinnext
            default { "detail" }
            disablewhen "{ gc_min_level_set_resolution_enable == 0 }"
            menu {
                "detail"    "Detail"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "form_mode_gc_min_level_set_resolution"
            label   "Form Mode"
            type    ordinal
            nolabel
            default { "value" }
            disablewhen "{ gc_min_level_set_resolution_enable == 0 }"
            menu {
                "attrib"    "Attribute"
                "value"     "Value"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "gc_min_level_set_resolution_from"
            label   "Attribute From"
            type    string
            default { "unreal_gc_collisions_min_level_set_resolution_X" }
            disablewhen "{ gc_min_level_set_resolution_enable == 0 } { form_mode_gc_min_level_set_resolution != attrib }"
            menureplace {
                [ "node = hou.pwd()" ]
                [ "owner = node.parm(\"owner_gc_min_level_set_resolution\").evalAsString()" ]
                [ "in_node = node.node(\"IN\")" ]
                [ "if not in_node:" ]
                [ "    return []" ]
                [ "geo = in_node.geometry()" ]
                [ "attrs = []" ]
                [ "if owner == \"point\":" ]
                [ "    attrs = [a.name() for a in geo.pointAttribs()]" ]
                [ "elif owner == \"prim\":" ]
                [ "    attrs = [a.name() for a in geo.primAttribs()]" ]
                [ "elif owner == \"vertex\":" ]
                [ "    attrs = [a.name() for a in geo.vertexAttribs()]" ]
                [ "elif owner == \"detail\":" ]
                [ "    attrs = [a.name() for a in geo.globalAttribs()]" ]
                [ "menu = []" ]
                [ "for a in attrs:" ]
                [ "    menu += [a, a]" ]
                [ "return menu" ]
                language python
            }
            parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'owner_gc_min_level_set_resolution')" }
            parmtag { "menu_script_language" "python" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "gc_min_level_set_resolution_val"
            label   "Resolution Value"
            type    integer
            default { "5" }
            disablewhen "{ gc_min_level_set_resolution_enable == 0 } { form_mode_gc_min_level_set_resolution != value }"
            range   { 1 100 }
            parmtag { "script_callback_language" "python" }
        }
    }

    parm {
        name    "gc_implicit_type_enable"
        label   "Implicit Type"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    groupcollapsible {
        name    "grp_gc_implicit_type"
        label   "Implicit Type"
        parmtag { "group_default" "0" }
        parmtag { "sidefx::header_toggle" "gc_implicit_type_enable" }

        parm {
            name    "gc_implicit_type_heading"
            label   "Heading"
            type    label
            default { "unreal_gc_collisions_implicit_type_X" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "gc_implicit_type_help"
            label   "Help"
            type    label
            default { "说明：指定碰撞的隐式类型。0=None,1=Box,2=Sphere,3=Capsule,4=Level Set,5=Convex。X 指定大小特定数据的索引。\n示例(Attribute)：unreal_gc_collisions_implicit_type_0=1\n示例(Value)：1\n结果：定义碰撞形状。\nOwner：Int。" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "owner_gc_implicit_type"
            label   "Attribute Owner"
            type    ordinal
            nolabel
            joinnext
            default { "detail" }
            disablewhen "{ gc_implicit_type_enable == 0 }"
            menu {
                "detail"    "Detail"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "form_mode_gc_implicit_type"
            label   "Form Mode"
            type    ordinal
            nolabel
            default { "value" }
            disablewhen "{ gc_implicit_type_enable == 0 }"
            menu {
                "attrib"    "Attribute"
                "value"     "Value"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "gc_implicit_type_from"
            label   "Attribute From"
            type    string
            default { "unreal_gc_collisions_implicit_type_X" }
            disablewhen "{ gc_implicit_type_enable == 0 } { form_mode_gc_implicit_type != attrib }"
            menureplace {
                [ "node = hou.pwd()" ]
                [ "owner = node.parm(\"owner_gc_implicit_type\").evalAsString()" ]
                [ "in_node = node.node(\"IN\")" ]
                [ "if not in_node:" ]
                [ "    return []" ]
                [ "geo = in_node.geometry()" ]
                [ "attrs = []" ]
                [ "if owner == \"point\":" ]
                [ "    attrs = [a.name() for a in geo.pointAttribs()]" ]
                [ "elif owner == \"prim\":" ]
                [ "    attrs = [a.name() for a in geo.primAttribs()]" ]
                [ "elif owner == \"vertex\":" ]
                [ "    attrs = [a.name() for a in geo.vertexAttribs()]" ]
                [ "elif owner == \"detail\":" ]
                [ "    attrs = [a.name() for a in geo.globalAttribs()]" ]
                [ "menu = []" ]
                [ "for a in attrs:" ]
                [ "    menu += [a, a]" ]
                [ "return menu" ]
                language python
            }
            parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'owner_gc_implicit_type')" }
            parmtag { "menu_script_language" "python" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "gc_implicit_type_val"
            label   "Type Value"
            type    ordinal
            default { "1" }
            disablewhen "{ gc_implicit_type_enable == 0 } { form_mode_gc_implicit_type != value }"
            menu {
                "0" "None"
                "1" "Box"
                "2" "Sphere"
                "3" "Capsule"
                "4" "Level Set"
                "5" "Convex"
            }
            parmtag { "script_callback_language" "python" }
        }
    }


}