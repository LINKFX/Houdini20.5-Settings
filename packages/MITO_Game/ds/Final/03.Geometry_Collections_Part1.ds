            type    label
            default { "说明：指定聚类连接类型。0 = PointImplicit, 1 = MinimalSpanningSubsetDelaunayTriangulation, 3 = PointImplicitAugmentedWithMinimalDelaunay。 示例(Attribute)：unreal_gc_clustering_cluster_connection_type=0 示例(Value)：0 结果：定义聚类中碎片的连接方式。 Owner：Detail。" }
            parmtag { "sidefx::look" "heading" }
