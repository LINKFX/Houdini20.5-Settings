                [ "owner = node.parm(\"owner_gc_cluster_connection\").evalAsString()" ]
                [ "in_node = node.node(\"IN\")" ]
                [ "if not in_node:" ]
                [ "    return []" ]
                [ "geo = in_node.geometry()" ]
                [ "attrs = []" ]
                [ "if owner == \"point\":" ]
                [ "    attrs = [a.name() for a in geo.pointAttribs()]" ]
                [ "elif owner == \"prim\":" ]
                [ "    attrs = [a.name() for a in geo.primAttribs()]" ]
                [ "elif owner == \"vertex\":" ]
                [ "    attrs = [a.name() for a in geo.vertexAttribs()]" ]
                [ "elif owner == \"detail\":" ]
                [ "    attrs = [a.name() for a in geo.globalAttribs()]" ]
                [ "menu = []" ]
                [ "for a in attrs:" ]
                [ "    menu += [a, a]" ]
                [ "return menu" ]
                language python
            }
            parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'owner_gc_cluster_connection')" }
            parmtag { "menu_script_language" "python" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "gc_cluster_connection_val"
            label   "Connection Type"
            type    ordinal
            default { "0" }
            disablewhen "{ gc_cluster_connection_enable == 0 } { form_mode_gc_cluster_connection != value }"
            menu {
                "0" "PointImplicit"
                "1" "MinimalSpanningSubsetDelaunayTriangulation"
                "2" "PointImplicitAugmentedWithMinimalDelaunay"
            }
            range   { 0 3 }
            parmtag { "script_callback_language" "python" }
        }
    }

    parm {
