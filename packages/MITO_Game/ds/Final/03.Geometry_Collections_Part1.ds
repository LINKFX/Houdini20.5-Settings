{
    name	selectedparms

    parm {
        name    "gc_output_enable"
        label   "Geometry Collection Output"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    groupcollapsible {
        name    "grp_gc_output"
        label   "Geometry Collection Output"
        parmtag { "group_default" "0" }
        parmtag { "sidefx::header_toggle" "gc_output_enable" }

        parm {
            name    "gc_output_heading"
            label   "Heading"
            type    label
            default { "unreal_output_geometry_collection" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "gc_output_help"
            label   "Help"
            type    label
            default { "说明：将几何作为 Geometry Collection 输出，用于 Chaos 破碎/聚类模拟。\n示例(Attribute)：unreal_output_geometry_collection=1\n示例(Value)：勾选启用\n结果：Bake 为 Geometry Collection 资源或其实例，用于后续碎裂与动力学。\nOwner：Prim。" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "owner_gc_output"
            label   "Attribute Owner"
            type    ordinal
            nolabel
            joinnext
            default { "detail" }
            disablewhen "{ gc_output_enable == 0 }"
            menu {
                "point"     "Point"
                "prim"      "Prim"
                "vertex"    "Vertex"
                "detail"    "Detail"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "form_mode_gc_output"
            label   "Form Mode"
            type    ordinal
            nolabel
            default { "value" }
            disablewhen "{ gc_output_enable == 0 }"
            menu {
                "attrib"    "Attribute"
                "value"     "Value"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "gc_output_from"
            label   "Attribute From"
            type    string
            default { "unreal_output_geometry_collection" }
            disablewhen "{ gc_output_enable == 0 } { form_mode_gc_output != attrib }"
            menureplace {
                [ "node = hou.pwd()" ]
                [ "owner = node.parm(\"owner_gc_output\").evalAsString()" ]
                [ "in_node = node.node(\"IN\")" ]
                [ "if not in_node:" ]
                [ "    return []" ]
                [ "geo = in_node.geometry()" ]
                [ "attrs = []" ]
                [ "if owner == \"point\":" ]
                [ "    attrs = [a.name() for a in geo.pointAttribs()]" ]
                [ "elif owner == \"prim\":" ]
                [ "    attrs = [a.name() for a in geo.primAttribs()]" ]
                [ "elif owner == \"vertex\":" ]
                [ "    attrs = [a.name() for a in geo.vertexAttribs()]" ]
                [ "elif owner == \"detail\":" ]
                [ "    attrs = [a.name() for a in geo.globalAttribs()]" ]
                [ "menu = []" ]
                [ "for a in attrs:" ]
                [ "    menu += [a, a]" ]
                [ "return menu" ]
                language python
            }
            parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'owner_gc_output')" }
            parmtag { "menu_script_language" "python" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "gc_output_val"
            label   "Output Enabled"
            type    toggle
            default { "1" }
            disablewhen "{ gc_output_enable == 0 } { form_mode_gc_output != value }"
            range   { 0 1 }
            parmtag { "script_callback_language" "python" }
        }
    }

    parm {
        name    "gc_cluster_enable"
        label   "Enable Clustering"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    groupcollapsible {
        name    "grp_gc_cluster"
        label   "Enable Clustering"
        parmtag { "group_default" "0" }
        parmtag { "sidefx::header_toggle" "gc_cluster_enable" }

        parm {
            name    "gc_cluster_heading"
            label   "Heading"
            type    label
            default { "unreal_gc_enable_clustering" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "gc_cluster_help"
            label   "Help"
            type    label
            default { "说明：启用层级聚类（由大到小的分层碎片），与“Max Cluster Level”配合使用。\n示例(Attribute)：unreal_gc_enable_clustering=1\n示例(Value)：勾选启用\n结果：碎片以层级组织，便于逐级破坏控制。\nOwner：Prim。" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "owner_gc_cluster"
            label   "Attribute Owner"
            type    ordinal
            nolabel
            joinnext
            default { "detail" }
            disablewhen "{ gc_cluster_enable == 0 }"
            menu {
                "detail"    "Detail"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "form_mode_gc_cluster"
            label   "Form Mode"
            type    ordinal
            nolabel
            default { "value" }
            disablewhen "{ gc_cluster_enable == 0 }"
            menu {
                "attrib"    "Attribute"
                "value"     "Value"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "gc_cluster_from"
            label   "Attribute From"
            type    string
            default { "unreal_gc_enable_clustering" }
            disablewhen "{ gc_cluster_enable == 0 } { form_mode_gc_cluster != attrib }"
            menureplace {
                [ "node = hou.pwd()" ]
                [ "owner = node.parm(\"owner_gc_cluster\").evalAsString()" ]
                [ "in_node = node.node(\"IN\")" ]
                [ "if not in_node:" ]
                [ "    return []" ]
                [ "geo = in_node.geometry()" ]
                [ "attrs = []" ]
                [ "if owner == \"point\":" ]
                [ "    attrs = [a.name() for a in geo.pointAttribs()]" ]
                [ "elif owner == \"prim\":" ]
                [ "    attrs = [a.name() for a in geo.primAttribs()]" ]
                [ "elif owner == \"vertex\":" ]
                [ "    attrs = [a.name() for a in geo.vertexAttribs()]" ]
                [ "elif owner == \"detail\":" ]
                [ "    attrs = [a.name() for a in geo.globalAttribs()]" ]
                [ "menu = []" ]
                [ "for a in attrs:" ]
                [ "    menu += [a, a]" ]
                [ "return menu" ]
                language python
            }
            parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'owner_gc_cluster')" }
            parmtag { "menu_script_language" "python" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "gc_cluster_val"
            label   "Cluster Enabled"
            type    toggle
            default { "1" }
            disablewhen "{ gc_cluster_enable == 0 } { form_mode_gc_cluster != value }"
            range   { 0 1 }
            parmtag { "script_callback_language" "python" }
        }
    }

    parm {
        name    "gc_cluster_connection_enable"
