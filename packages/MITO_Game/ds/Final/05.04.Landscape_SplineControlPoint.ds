{
    name	selectedparms

    group {
        name    "folder3_3"
        label   "Splines_ControlPoint"
        parmtag { "group_default" "0" }
        grouptag { "import_enable" "1" }
        grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.Landscape.ds" }
        grouptag { "import_token" "folder3:Splines_Segment" }

        parm {
            name    "en_rot"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.04.Landscape_SplineControlPoint.ds" }
            parmtag { "import_token" "en_rot" }
            parmtag { "script_callback_language" "python" }
        }
        groupcollapsible {
            name    "grp_rot"
            label   "Rotation"
            parmtag { "group_default" "0" }
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.04.Landscape_SplineControlPoint.ds" }
            grouptag { "import_token" "grp_rot:Rotation" }
            parmtag { "sidefx::header_toggle" "en_rot" }

            parm {
                name    "rot_heading"
                label   "Heading"
                type    label
                default { "rot" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.04.Landscape_SplineControlPoint.ds" }
                parmtag { "import_token" "rot_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "rot_help"
                label   "Help"
                type    label
                default { "说明：控制点的旋转，单位为度。可通过 Attribute 传入旋转向量 (x y z)，或直接输入数值。\n示例(Attribute)：来源 attr=rot → rot=(0,90,0)。\n示例(Value)：直接输入 0 90 0。\n结果：Bake 时会设置该控制点的旋转。\nOwner：Point/Vertex。" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.04.Landscape_SplineControlPoint.ds" }
                parmtag { "import_token" "rot_help" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_rot"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "point" }
                disablewhen "{ en_rot == 0 }"
                menu {
                    "point"     "Point"
                    "vertex"    "Vertex"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.04.Landscape_SplineControlPoint.ds" }
                parmtag { "import_token" "owner_rot" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "form_mode_rot"
                label   "Form Mode"
                type    ordinal
                nolabel
                default { "value" }
                disablewhen "{ en_rot == 0 }"
                menu {
                    "attrib"    "Attribute"
                    "value"     "Value"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.04.Landscape_SplineControlPoint.ds" }
                parmtag { "import_token" "form_mode_rot" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "rot_from"
                label   "Attribute From"
                type    string
                default { "rot" }
                disablewhen "{ en_rot == 0 } { form_mode_rot != attrib }"
                menureplace {
                    [ "node = hou.pwd()" ]
                    [ "owner = node.parm(\"owner_rot\").evalAsString()" ]
                    [ "" ]
                    [ "in_node = node.node(\"IN\")" ]
                    [ "if not in_node:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "geo = in_node.geometry()" ]
                    [ "attrs = []" ]
                    [ "" ]
                    [ "if owner == \"point\":" ]
                    [ "    attrs = [a.name() for a in geo.pointAttribs()]" ]
                    [ "elif owner == \"prim\":" ]
                    [ "    attrs = [a.name() for a in geo.primAttribs()]" ]
                    [ "elif owner == \"vertex\":" ]
                    [ "    attrs = [a.name() for a in geo.vertexAttribs()]" ]
                    [ "elif owner == \"detail\":" ]
                    [ "    attrs = [a.name() for a in geo.globalAttribs()]" ]
                    [ "" ]
                    [ "menu = []" ]
                    [ "for a in attrs:" ]
                    [ "    menu += [a, a]" ]
                    [ "" ]
                    [ "return menu" ]
                    language python
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.04.Landscape_SplineControlPoint.ds" }
                parmtag { "import_token" "rot_from" }
                parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'owner_rot')" }
                parmtag { "menu_script_language" "python" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "rot_val"
                label   "Rotation Value"
                type    vector
                size    3
                default { "0" "0" "0" }
                disablewhen "{ en_rot == 0 } { form_mode_rot != value }"
                range   { -1 1 }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.04.Landscape_SplineControlPoint.ds" }
                parmtag { "import_token" "rot_val" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_unreal_landscape_spline_control_point_id"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.04.Landscape_SplineControlPoint.ds" }
            parmtag { "import_token" "en_unreal_landscape_spline_control_point_id" }
            parmtag { "script_callback_language" "python" }
