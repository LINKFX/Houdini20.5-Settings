                default { "0" }
                disablewhen "{ en_unreal_landscape_spline_control_point_id == 0 } { form_mode_unreal_landscape_spline_control_point_id != value }"
                range   { 0 10 }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.04.Landscape_SplineControlPoint.ds" }
                parmtag { "import_token" "unreal_landscape_spline_control_point_id_val" }
