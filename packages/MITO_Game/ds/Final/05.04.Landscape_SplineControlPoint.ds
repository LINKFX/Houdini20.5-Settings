                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.04.Landscape_SplineControlPoint.ds" }
                parmtag { "import_token" "form_mode_unreal_landscape_spline_control_point_id" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "unreal_landscape_spline_control_point_id_from"
                label   "Attribute From"
                type    string
                default { "unreal_landscape_spline_control_point_id" }
                disablewhen "{ en_unreal_landscape_spline_control_point_id == 0 } { form_mode_unreal_landscape_spline_control_point_id != attrib }"
                menureplace {
                    [ "node = hou.pwd()" ]
