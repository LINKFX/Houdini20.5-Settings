                parmtag { "import_token" "unreal_landscape_spline_control_point_id_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "unreal_landscape_spline_control_point_id_help"
                label   "Help"
                type    label
                default { "说明：控制点的唯一 ID，用于识别和匹配。\n示例(Attribute)：来源 attr=id → 写出 1001。\n示例(Value)：直接输入 1001。\n结果：Bake 时会为该控制点指定唯一编号。\nOwner：Point/Vertex。" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.04.Landscape_SplineControlPoint.ds" }
                parmtag { "import_token" "unreal_landscape_spline_control_point_id_help" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_unreal_landscape_spline_control_point_id"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "point" }
                disablewhen "{ en_unreal_landscape_spline_control_point_id == 0 }"
                menu {
                    "point"     "Point"
                    "vertex"    "Vertex"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.04.Landscape_SplineControlPoint.ds" }
                parmtag { "import_token" "owner_unreal_landscape_spline_control_point_id" }
                parmtag { "script_callback_language" "python" }
