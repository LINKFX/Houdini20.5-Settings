{
    name    selectedparms

    group {
        name    "folder3"
        label   "Main"
        parmtag { "group_default" "0" }
        grouptag { "import_enable" "1" }
        grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.Landscape.ds" }
        grouptag { "import_token" "folder3:Splines_Segment" }

        parm {
            name    "en_mat_hole"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
            parmtag { "import_token" "en_mat_hole" }
            parmtag { "script_callback_language" "python" }
        }
        groupcollapsible {
            name    "grp_mat_hole"
            label   "Material Hole"
            parmtag { "group_default" "0" }
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
            grouptag { "import_token" "grp_mat_hole:Material Hole" }
            parmtag { "sidefx::header_parm" "mat_hole_path" }
            parmtag { "sidefx::header_toggle" "en_mat_hole" }

            parm {
                name    "mat_hole_heading"
                label   "Heading"
                type    label
                default { "unreal_material_hole" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "mat_hole_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "mat_hole_help_heading"
                label   "Help"
                type    label
                default { "说明：指定用于 Landscape 洞（Hole）的材质资源路径（Content Path），用于标记被挖空区域。 \n示例：/Game/Materials/M_LandscapeHole → 实际写出 unreal_material_hole=/Game/Materials/M_LandscapeHole。 \n结果：UE 中可在地形使用该材质处理洞区域（通常配合 Masked 材质）。 \nOwner：Prim/Detail。 " }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "mat_hole_help_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_mat_hole"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_mat_hole == 0 }"
                menu {
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "owner_mat_hole" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "form_mode_mat_hole_path"
                label   "Form Mode"
                type    ordinal
                nolabel
                default { "value" }
                menu {
                    "attrib"    "Attribute"
                    "value"     "Value"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "form_mode_mat_hole_path" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "mat_hole_path_from"
                label   "Attribute From"
                type    string
                default { "" }
                disablewhen "{ form_mode_mat_hole_path != attrib }"
                menureplace {
                    [ "node = hou.pwd()" ]
                    [ "owner = node.parm(\"owner_mat_hole\").evalAsString()" ]
                    [ "" ]
                    [ "in_node = node.node(\"IN\")" ]
                    [ "if not in_node:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "geo = in_node.geometry()" ]
                    [ "attrs = []" ]
                    [ "" ]
                    [ "if owner == \"point\":" ]
                    [ "    attrs = [a.name() for a in geo.pointAttribs()]" ]
                    [ "elif owner == \"prim\":" ]
                    [ "    attrs = [a.name() for a in geo.primAttribs()]" ]
                    [ "elif owner == \"vertex\":" ]
                    [ "    attrs = [a.name() for a in geo.vertexAttribs()]" ]
                    [ "elif owner == \"detail\":" ]
                    [ "    attrs = [a.name() for a in geo.globalAttribs()]" ]
                    [ "" ]
                    [ "menu = []" ]
                    [ "for a in attrs:" ]
                    [ "    menu += [a, a]" ]
                    [ "" ]
                    [ "return menu" ]
                    language python
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "mat_hole_path_from" }
                parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'owner_mat_hole')" }
                parmtag { "menu_script_language" "python" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "mat_hole_path"
                label   "Content Path"
                type    string
                default { "/Game/Materials/M_LandscapeHole" }
                disablewhen "{ en_mat_hole == 0 } { form_mode_mat_hole_path != value }"
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "mat_hole_path" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_shared_actor"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
            parmtag { "import_token" "en_shared_actor" }
            parmtag { "script_callback_language" "python" }
        }
        groupcollapsible {
            name    "grp_shared_actor"
            label   "Shared Actor Name"
            parmtag { "group_default" "0" }
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
            grouptag { "import_token" "grp_shared_actor:Shared Actor Name" }
            parmtag { "sidefx::header_parm" "shared_actor_name" }
            parmtag { "sidefx::header_toggle" "en_shared_actor" }

            parm {
                name    "shared_actor_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_shared_actor_name" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "shared_actor_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "shared_actor_help_heading"
                label   "Help"
                type    label
                default { "说明：启用 Landscape Streaming Proxies 时，用于主/共享 Landscape Actor 的命名。支持字符串 Token（如 {hda_actor_name}）。 \n示例：{hda_actor_name}_SharedLandscape → 实际写出 unreal_landscape_shared_actor_name={hda_actor_name}_SharedLandscape。 \n结果：各 Tile Actor 会从该共享名读取/派生。 \nOwner：Point/Prim/Detail。 " }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "shared_actor_help_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_shared_actor"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_shared_actor == 0 }"
                menu {
                    "point"     "Point"
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "owner_shared_actor" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "shared_actor_name"
                label   "Name"
                type    string
                default { "{hda_actor_name}_SharedLandscape" }
                disablewhen "{ en_shared_actor == 0 }"
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "shared_actor_name" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_layer_min"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
            parmtag { "import_token" "en_layer_min" }
            parmtag { "script_callback_language" "python" }
        }
        groupcollapsible {
            name    "grp_layer_min"
            label   "Layer Min"
            parmtag { "group_default" "0" }
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
            grouptag { "import_token" "grp_layer_min:Layer Min" }
            parmtag { "sidefx::header_parm" "layer_min_val" }
            parmtag { "sidefx::header_toggle" "en_layer_min" }

            parm {
                name    "layer_min_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_layer_min" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "layer_min_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "layer_min_help_heading"
                label   "Help"
                type    label
                default { "说明：将高度/权重值转换到 Landscape 时的最小阈值（归一化映射下界）。 \n示例：0 → 实际写出 unreal_landscape_layer_min=0。 \n结果：用于保证不同 Tile 以一致方式转换。 \nOwner：Point/Prim/Detail。 " }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "layer_min_help_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_layer_min"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_layer_min == 0 }"
                menu {
                    "point"     "Point"
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "owner_layer_min" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "form_mode_layer_min_val"
                label   "Form Mode"
                type    ordinal
                nolabel
                default { "value" }
                menu {
                    "attrib"    "Attribute"
                    "value"     "Value"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "form_mode_layer_min_val" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "layer_min_val_from"
                label   "Attribute From"
                type    string
                default { "" }
                disablewhen "{ form_mode_layer_min_val != attrib }"
                menureplace {
                    [ "node = hou.pwd()" ]
                    [ "owner = node.parm(\"owner_layer_min\").evalAsString()" ]
                    [ "" ]
                    [ "in_node = node.node(\"IN\")" ]
                    [ "if not in_node:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "geo = in_node.geometry()" ]
                    [ "attrs = []" ]
                    [ "" ]
                    [ "if owner == \"point\":" ]
                    [ "    attrs = [a.name() for a in geo.pointAttribs()]" ]
                    [ "elif owner == \"prim\":" ]
                    [ "    attrs = [a.name() for a in geo.primAttribs()]" ]
                    [ "elif owner == \"vertex\":" ]
                    [ "    attrs = [a.name() for a in geo.vertexAttribs()]" ]
                    [ "elif owner == \"detail\":" ]
                    [ "    attrs = [a.name() for a in geo.globalAttribs()]" ]
                    [ "" ]
                    [ "menu = []" ]
                    [ "for a in attrs:" ]
                    [ "    menu += [a, a]" ]
                    [ "" ]
                    [ "return menu" ]
                    language python
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "layer_min_val_from" }
                parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'owner_layer_min')" }
                parmtag { "menu_script_language" "python" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "layer_min_val"
                label   "Value"
                type    float
                default { "0" }
                disablewhen "{ en_layer_min == 0 } { form_mode_layer_min_val != value }"
                range   { 0 10 }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "layer_min_val" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_layer_max"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
            parmtag { "import_token" "en_layer_max" }
            parmtag { "script_callback_language" "python" }
        }
        groupcollapsible {
            name    "grp_layer_max"
