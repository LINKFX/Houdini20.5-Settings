                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "form_mode_editlayer_name_str"
                label   "Form Mode"
                type    ordinal
                nolabel
                default { "value" }
                menu {
                    "attrib"    "Attribute"
                    "value"     "Value"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "form_mode_editlayer_name_str" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "editlayer_name_str_from"
                label   "Attribute From"
                type    string
                default { "" }
                disablewhen "{ form_mode_editlayer_name_str != attrib }"
                menureplace {
                    [ "node = hou.pwd()" ]
                    [ "owner = node.parm(\"owner_editlayer_name\").evalAsString()" ]
                    [ "" ]
                    [ "in_node = node.node(\"IN\")" ]
                    [ "if not in_node:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "geo = in_node.geometry()" ]
                    [ "attrs = []" ]
                    [ "" ]
                    [ "if owner == \"point\":" ]
                    [ "    attrs = [a.name() for a in geo.pointAttribs()]" ]
                    [ "elif owner == \"prim\":" ]
                    [ "    attrs = [a.name() for a in geo.primAttribs()]" ]
                    [ "elif owner == \"vertex\":" ]
                    [ "    attrs = [a.name() for a in geo.vertexAttribs()]" ]
                    [ "elif owner == \"detail\":" ]
                    [ "    attrs = [a.name() for a in geo.globalAttribs()]" ]
                    [ "" ]
                    [ "menu = []" ]
                    [ "for a in attrs:" ]
                    [ "    menu += [a, a]" ]
                    [ "" ]
                    [ "return menu" ]
                    language python
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
