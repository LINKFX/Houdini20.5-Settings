                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "grp_write_locked_layer_enabled"
                label   "Write Locked Layer Enabled"
                type    toggle
                default { "0" }
                disablewhen "{ en_write_locked_layer == 0 }"
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_section_size"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
            parmtag { "import_token" "en_section_size" }
            parmtag { "script_callback_language" "python" }
        }
        groupcollapsible {
            name    "grp_section_size"
            label   "Section Size"
            parmtag { "group_default" "0" }
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
            grouptag { "import_token" "grp_section_size:Section Size" }
            parmtag { "sidefx::header_parm" "section_size" }
            parmtag { "sidefx::header_toggle" "en_section_size" }

            parm {
                name    "section_size_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_section_size" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "section_size_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "section_size_help_heading"
                label   "Help"
                type    label
                default { "说明：设置 Landscape 的 Section 大小（如 63/127 等）。需与“Sections Per Component”配对设置。 \n示例：127 → 实际写出 unreal_landscape_section_size=127。 \n结果：影响地形组件的分割与渲染效率。 \nOwner：Prim。 " }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "section_size_help_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_section_size"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_section_size == 0 }"
                menu {
                    "prim"  "Prim"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "owner_section_size" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "section_size"
                label   "Size"
                type    integer
                default { "127" }
                disablewhen "{ en_section_size == 0 }"
                range   { 0 10 }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "section_size" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_sections_per_comp"
            label   "Enable"
