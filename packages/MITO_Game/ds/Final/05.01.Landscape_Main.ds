                label   "Help"
                type    label
                default { "说明：将高度/权重值转换到 Landscape 时的最大阈值（归一化映射上界）。 \n示例：1 → 实际写出 unreal_landscape_layer_max=1。 \n结果：与最小阈值配合用于统一 Tile 的转换范围。 \nOwner：Point/Prim/Detail。 " }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "layer_max_help_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_layer_max"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_layer_max == 0 }"
                menu {
                    "point"     "Point"
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "owner_layer_max" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "form_mode_layer_max_val"
                label   "Form Mode"
                type    ordinal
                nolabel
                default { "value" }
                menu {
                    "attrib"    "Attribute"
                    "value"     "Value"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "form_mode_layer_max_val" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "layer_max_val_from"
                label   "Attribute From"
                type    string
                default { "" }
                disablewhen "{ form_mode_layer_max_val != attrib }"
                menureplace {
                    [ "node = hou.pwd()" ]
                    [ "owner = node.parm(\"owner_layer_max\").evalAsString()" ]
                    [ "" ]
                    [ "in_node = node.node(\"IN\")" ]
                    [ "if not in_node:" ]
                    [ "    return []" ]
                    [ "" ]
                    [ "geo = in_node.geometry()" ]
                    [ "attrs = []" ]
                    [ "" ]
                    [ "if owner == \"point\":" ]
                    [ "    attrs = [a.name() for a in geo.pointAttribs()]" ]
                    [ "elif owner == \"prim\":" ]
                    [ "    attrs = [a.name() for a in geo.primAttribs()]" ]
                    [ "elif owner == \"vertex\":" ]
                    [ "    attrs = [a.name() for a in geo.vertexAttribs()]" ]
                    [ "elif owner == \"detail\":" ]
                    [ "    attrs = [a.name() for a in geo.globalAttribs()]" ]
                    [ "" ]
                    [ "menu = []" ]
                    [ "for a in attrs:" ]
                    [ "    menu += [a, a]" ]
                    [ "" ]
                    [ "return menu" ]
                    language python
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "layer_max_val_from" }
                parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'owner_layer_max')" }
