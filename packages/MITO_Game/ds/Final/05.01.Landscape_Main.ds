                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "layer_max_val" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_write_locked_layer"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "script_callback_language" "python" }
        }
        groupcollapsible {
            name    "grp_write_locked_layer"
            label   "Write Locked Layer"
            parmtag { "group_default" "0" }
            parmtag { "sidefx::header_toggle" "en_write_locked_layer" }

            parm {
                name    "write_locked_layer_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_write_locked_layer" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "write_locked_layer_help_heading"
                label   "Help"
                type    label
                default { "说明：允许将层数据写入锁定的 Landscape Edit Layer。 \n示例：启用 → 实际写出 unreal_landscape_write_locked_layer=1。 \n结果：支持向已锁定层写入。 \nOwner：Point/Prim/Detail。 " }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_write_locked_layer"
                label   "Attribute Owner"
