                default { "说明：导入单 Tile 时的总 Landscape 尺寸（宽×高）。 \n示例：4033 / 4033 → 实际写出 unreal_landscape_landscape_size=(4033,4033)。 \n结果：用于确定目标 Landscape 的整体分辨率。 \nOwner：Prim。 " }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "landscape_size_help_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_landscape_size"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                default { "prim" }
                disablewhen "{ en_landscape_size == 0 }"
                menu {
                    "prim"  "Prim"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "owner_landscape_size" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "landscape_size_x"
                label   "Width"
                type    integer
                default { "4033" }
                disablewhen "{ en_landscape_size == 0 }"
                range   { 0 10 }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "landscape_size_x" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "landscape_size_y"
                label   "Height"
                type    integer
                default { "4033" }
                disablewhen "{ en_landscape_size == 0 }"
                range   { 0 10 }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "landscape_size_y" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_editlayer_target"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
            parmtag { "import_token" "en_editlayer_target" }
            parmtag { "script_callback_language" "python" }
        }
        groupcollapsible {
            name    "grp_editlayer_target"
            label   "EditLayer Target (deprecated)"
            parmtag { "group_default" "0" }
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
            grouptag { "import_token" "grp_editlayer_target:EditLayer Target (deprecated)" }
            parmtag { "sidefx::header_toggle" "en_editlayer_target" }

            parm {
                name    "editlayer_target_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_editlayer_target" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "editlayer_target_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "editlayer_target_help_heading"
                label   "Help"
                type    label
                default { "弃用：请改用 unreal_output_name 统一设置输出名称，或按需使用 unreal_landscape_editlayer_name 控制 Edit Layer 名称。 \n示例：Landscape → 现在应写 unreal_output_name=Landscape。 \n结果：以统一命名控制 Bake 的目标层/对象名。 \nOwner：Point/Prim/Detail。 " }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/Final/05.01.Landscape_Main.ds" }
                parmtag { "import_token" "editlayer_target_help_heading" }
                parmtag { "sidefx::look" "heading" }
            }
        }
    }
}