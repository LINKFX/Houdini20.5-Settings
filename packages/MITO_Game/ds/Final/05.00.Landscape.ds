    parm {
        name    "en_editlayer_clear"
        label   "Enable"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    groupcollapsible {
        name    "grp_editlayer_clear"
        label   "Clear EditLayer"
        parmtag { "group_default" "0" }
        parmtag { "sidefx::header_toggle" "en_editlayer_clear" }

        parm {
            name    "editlayer_clear_heading"
            label   "Heading"
            type    label
            default { "unreal_landscape_editlayer_clear" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "editlayer_clear_help_heading"
            label   "Help"
            type    label
            default { "说明：绘制前清空目标 Edit Layer。 \n示例：启用 → 实际写出 unreal_landscape_editlayer_clear=1。 \n结果：先清空，再写入新的高度/权重。 \nOwner：Point/Prim/Detail。 " }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "owner_editlayer_clear"
            label   "Attribute Owner"
            type    ordinal
            nolabel
            joinnext
            default { "prim" }
            disablewhen "{ en_editlayer_clear == 0 }"
            menu {
                "point"     "Point"
                "prim"      "Prim"
                "detail"    "Detail"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "newparameter4"
            label   "Clear EditLayer Enabled"
            type    toggle
            default { "0" }
            parmtag { "script_callback_language" "python" }
        }
    }

    parm {
        name    "en_editlayer_sub"
        label   "Enable"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    groupcollapsible {
        name    "grp_editlayer_sub"
        label   "Subtractive"
        parmtag { "group_default" "0" }
        parmtag { "sidefx::header_toggle" "en_editlayer_sub" }

        parm {
            name    "editlayer_sub_heading"
            label   "Heading"
            type    label
            default { "unreal_landscape_editlayer_subtractive" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "editlayer_sub_help_heading"
            label   "Help"
            type    label
            default { "说明：以 Subtractive Blend 写入掩码。 \n示例：启用 → 实际写出 unreal_landscape_editlayer_subtractive=1。 \n结果：UE 中对应 Paint Layer 的 Subtractive 属性为勾选。 \nOwner：Prim/Detail。 " }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "owner_editlayer_sub"
            label   "Attribute Owner"
            type    ordinal
            nolabel
            joinnext
            default { "prim" }
            disablewhen "{ en_editlayer_sub == 0 }"
            menu {
                "prim"      "Prim"
                "detail"    "Detail"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "newparameter5"
            label   "Subtractive Enabled"
            type    toggle
            default { "0" }
            parmtag { "script_callback_language" "python" }
        }
    }

    parm {
        name    "en_lock_after"
        label   "Enable"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    groupcollapsible {
        name    "grp_lock_after"
        label   "Lock After"
        parmtag { "group_default" "0" }
        parmtag { "sidefx::header_toggle" "en_lock_after" }

        parm {
            name    "lock_after_heading"
            label   "Heading"
            type    label
            default { "unreal_landscape_lock_layer" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "lock_after_help_heading"
            label   "Help"
            type    label
            default { "说明：写入完成后锁定目标 Edit Layer。 \n示例：启用 → 实际写出 unreal_landscape_lock_layer=1。 \n结果：图层被标记为锁定，避免后续误写。 \nOwner：Point/Prim/Detail。 " }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "owner_lock_after"
            label   "Attribute Owner"
            type    ordinal
            nolabel
            joinnext
            default { "prim" }
            disablewhen "{ en_lock_after == 0 }"
            menu {
                "point"     "Point"
                "prim"      "Prim"
                "detail"    "Detail"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "newparameter6"
            label   "Lock After Enabled"
            type    toggle
            default { "0" }
            parmtag { "script_callback_language" "python" }
        }
    }

    parm {
        name    "en_partition_grid"
        label   "Enable"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    groupcollapsible {
        name    "grp_partition_grid"
        label   "Partition Grid Size"
        parmtag { "group_default" "0" }
        parmtag { "sidefx::header_parm" "partition_grid_size" }
        parmtag { "sidefx::header_toggle" "en_partition_grid" }

        parm {
            name    "partition_grid_heading"
            label   "Heading"
            type    label
            default { "unreal_landscape_partition_grid_size" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "partition_grid_help_heading"
            label   "Help"
            type    label
            default { "说明：控制关卡启用世界分区时的 Landscape 分区网格尺寸（仅在启用 World Partition 的关卡里生效）。 \n示例：0 → 实际写出 unreal_landscape_partition_grid_size=0。 \n结果：影响 Landscape 的分区切分与流式加载。 \nOwner：Prim。 " }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "owner_partition_grid"
            label   "Attribute Owner"
            type    ordinal
            nolabel
            joinnext
            default { "prim" }
            disablewhen "{ en_partition_grid == 0 }"
            menu {
                "prim"  "Prim"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "partition_grid_size"
            label   "Value"
            type    integer
            default { "0" }
            disablewhen "{ en_partition_grid == 0 }"
            range   { 0 10 }
            parmtag { "script_callback_language" "python" }
        }
    }

    parm {
        name    "en_landscape_size"
        label   "Enable"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    groupcollapsible {
        name    "grp_landscape_size"
        label   "Landscape Size (Single Tile)"
        parmtag { "group_default" "0" }
        parmtag { "sidefx::header_parm" "landscape_size_x" }
        parmtag { "sidefx::header_toggle" "en_landscape_size" }

        parm {
            name    "landscape_size_heading"
            label   "Heading"
            type    label
            default { "unreal_landscape_landscape_size" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "landscape_size_help_heading"
            label   "Help"
            type    label
            default { "说明：导入单 Tile 时的总 Landscape 尺寸（宽×高）。 \n示例：4033 / 4033 → 实际写出 unreal_landscape_landscape_size=(4033,4033)。 \n结果：用于确定目标 Landscape 的整体分辨率。 \nOwner：Prim。 " }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "owner_landscape_size"
            label   "Attribute Owner"
            type    ordinal
            nolabel
            default { "prim" }
            disablewhen "{ en_landscape_size == 0 }"
            menu {
                "prim"  "Prim"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "landscape_size_x"
            label   "Width"
            type    integer
            default { "4033" }
            disablewhen "{ en_landscape_size == 0 }"
            range   { 0 10 }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "landscape_size_y"
            label   "Height"
            type    integer
            default { "4033" }
            disablewhen "{ en_landscape_size == 0 }"
            range   { 0 10 }
            parmtag { "script_callback_language" "python" }
        }
    }

    parm {
        name    "en_editlayer_target"
        label   "Enable"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    groupcollapsible {
        name    "grp_editlayer_target"
        label   "EditLayer Target (deprecated)"
        parmtag { "group_default" "0" }
        parmtag { "sidefx::header_toggle" "en_editlayer_target" }

        parm {
            name    "editlayer_target_heading"
            label   "Heading"
            type    label
            default { "unreal_landscape_editlayer_target" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "editlayer_target_help_heading"
            label   "Help"
            type    label
            default { "弃用：请改用 unreal_output_name 统一设置输出名称，或按需使用 unreal_landscape_editlayer_name 控制 Edit Layer 名称。 \n示例：Landscape → 现在应写 unreal_output_name=Landscape。 \n结果：以统一命名控制 Bake 的目标层/对象名。 \nOwner：Point/Prim/Detail。 " }
            parmtag { "sidefx::look" "heading" }
        }
    }


}