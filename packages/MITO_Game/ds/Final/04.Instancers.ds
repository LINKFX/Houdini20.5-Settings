                "value"     "Value"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "inst_foliage_dist_from"
            label   "Attribute From"
            type    string
            default { "unreal_foliage_attachment_distance" }
            disablewhen "{ en_inst_foliage_dist == 0 } { form_mode_inst_foliage_dist != attrib }"
            menureplace {
                [ "node = hou.pwd()" ]
                [ "owner = node.parm(\"owner_inst_foliage_dist\").evalAsString()" ]
                [ "" ]
                [ "in_node = node.node(\"IN\")" ]
                [ "if not in_node:" ]
                [ "    return []" ]
                [ "" ]
                [ "geo = in_node.geometry()" ]
                [ "attrs = []" ]
                [ "" ]
                [ "if owner == \"point\":" ]
                [ "    attrs = [a.name() for a in geo.pointAttribs()]" ]
                [ "elif owner == \"prim\":" ]
                [ "    attrs = [a.name() for a in geo.primAttribs()]" ]
                [ "elif owner == \"vertex\":" ]
                [ "    attrs = [a.name() for a in geo.vertexAttribs()]" ]
                [ "elif owner == \"detail\":" ]
                [ "    attrs = [a.name() for a in geo.globalAttribs()]" ]
                [ "" ]
                [ "menu = []" ]
                [ "for a in attrs:" ]
                [ "    menu += [a, a]" ]
                [ "" ]
                [ "return menu" ]
                language python
            }
            parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'owner_inst_foliage_dist')" }
            parmtag { "menu_script_language" "python" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "inst_foliage_dist_val"
            label   "Attachment Distance"
            type    float
            default { "1000" }
            disablewhen "{ en_inst_foliage_dist == 0 } { form_mode_inst_foliage_dist != value }"
            range   { 0 10000 }
            parmtag { "script_callback_language" "python" }
        }
    }

    parm {
        name    "en_inst_split"
        label   "Enable"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    groupcollapsible {
        name    "grp_inst_split"
        label   "Unreal Split Attribute"
        parmtag { "sidefx::header_toggle" "en_inst_split" }

        parm {
            name    "inst_split_heading"
            label   "Heading"
            type    label
            default { "unreal_split_attr" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "inst_split_help"
            label   "Help"
            type    label
            default { "说明：指定一个属性名，按其值将实例拆分为多个组件。\n示例(Attribute)：来源 attr=my_group → 写出 unreal_split_attr=my_group。\n示例(数值)：直接输入 my_type → UE 中实例按 my_type 值拆分。\n结果：实现实例的组件化拆分。\nOwner：Any。" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "owner_inst_split"
            label   "Attribute Owner"
            type    ordinal
            nolabel
            joinnext
            default { "point" }
            disablewhen "{ en_inst_split == 0 }"
            menu {
                "point"     "Point"
                "vertex"    "Vertex"
                "prim"      "Prim"
                "detail"    "Detail"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "form_mode_inst_split"
            label   "Form Mode"
            type    ordinal
            nolabel
            default { "value" }
            disablewhen "{ en_inst_split == 0 }"
            menu {
                "attrib"    "Attribute"
                "value"     "Value"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "inst_split_from"
            label   "Attribute From"
            type    string
            default { "unreal_split_attr" }
            disablewhen "{ en_inst_split == 0 } { form_mode_inst_split != attrib }"
            menureplace {
                [ "node = hou.pwd()" ]
                [ "owner = node.parm(\"owner_inst_split\").evalAsString()" ]
                [ "" ]
                [ "in_node = node.node(\"IN\")" ]
                [ "if not in_node:" ]
                [ "    return []" ]
                [ "" ]
                [ "geo = in_node.geometry()" ]
                [ "attrs = []" ]
                [ "" ]
                [ "if owner == \"point\":" ]
                [ "    attrs = [a.name() for a in geo.pointAttribs()]" ]
                [ "elif owner == \"prim\":" ]
                [ "    attrs = [a.name() for a in geo.primAttribs()]" ]
                [ "elif owner == \"vertex\":" ]
                [ "    attrs = [a.name() for a in geo.vertexAttribs()]" ]
                [ "elif owner == \"detail\":" ]
                [ "    attrs = [a.name() for a in geo.globalAttribs()]" ]
                [ "" ]
                [ "menu = []" ]
                [ "for a in attrs:" ]
                [ "    menu += [a, a]" ]
                [ "" ]
                [ "return menu" ]
                language python
            }
            parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'owner_inst_split')" }
            parmtag { "menu_script_language" "python" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "inst_split_val"
            label   "Split Attribute"
            type    string
            default { "my_type" }
            disablewhen "{ en_inst_split == 0 } { form_mode_inst_split != value }"
            parmtag { "script_callback_language" "python" }
        }
    }

    parm {
        name    "en_inst_hierarchical"
        label   "Enable"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    groupcollapsible {
        name    "grp_inst_hierarchical"
        label   "Hierarchical Instancer"
        parmtag { "sidefx::header_toggle" "en_inst_hierarchical" }

        parm {
            name    "inst_hierarchical_heading"
            label   "Heading"
            type    label
            default { "unreal_hierarchical_instancer" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "inst_hierarchical_help"
            label   "Help"
            type    label
            default { "说明：是否强制使用 Hierarchical Instanced Static Mesh Component (HISM)。可通过 Attribute 或数值指定。\n示例(Attribute)：来源 attr=1 → 写出 unreal_hierarchical_instancer=1。\n示例(数值)：直接设置=0 → UE 使用普通 Instancer。\n结果：1=强制使用 HISM，0=使用普通 Instancer。\nOwner：Any。" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "owner_inst_hierarchical"
            label   "Attribute Owner"
            type    ordinal
            nolabel
            joinnext
            default { "detail" }
            disablewhen "{ en_inst_hierarchical == 0 }"
            menu {
                "point"     "Point"
                "vertex"    "Vertex"
                "prim"      "Prim"
                "detail"    "Detail"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "form_mode_inst_hierarchical"
            label   "Form Mode"
            type    ordinal
            nolabel
            default { "value" }
            disablewhen "{ en_inst_hierarchical == 0 }"
            menu {
                "attrib"    "Attribute"
                "value"     "Value"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "inst_hierarchical_from"
            label   "Attribute From"
            type    string
            default { "unreal_hierarchical_instancer" }
            disablewhen "{ en_inst_hierarchical == 0 } { form_mode_inst_hierarchical != attrib }"
            menureplace {
                [ "node = hou.pwd()" ]
                [ "owner = node.parm(\"owner_inst_hierarchical\").evalAsString()" ]
                [ "" ]
                [ "in_node = node.node(\"IN\")" ]
                [ "if not in_node:" ]
                [ "    return []" ]
                [ "" ]
                [ "geo = in_node.geometry()" ]
                [ "attrs = []" ]
                [ "" ]
                [ "if owner == \"point\":" ]
                [ "    attrs = [a.name() for a in geo.pointAttribs()]" ]
                [ "elif owner == \"prim\":" ]
                [ "    attrs = [a.name() for a in geo.primAttribs()]" ]
                [ "elif owner == \"vertex\":" ]
                [ "    attrs = [a.name() for a in geo.vertexAttribs()]" ]
                [ "elif owner == \"detail\":" ]
                [ "    attrs = [a.name() for a in geo.globalAttribs()]" ]
                [ "" ]
                [ "menu = []" ]
                [ "for a in attrs:" ]
                [ "    menu += [a, a]" ]
                [ "" ]
                [ "return menu" ]
                language python
            }
            parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'owner_inst_hierarchical')" }
            parmtag { "menu_script_language" "python" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "inst_hierarchical_val"
            label   "Hierarchical Instancer"
            type    toggle
            default { "1" }
            disablewhen "{ en_inst_hierarchical == 0 } { form_mode_inst_hierarchical != value }"
            parmtag { "script_callback_language" "python" }
        }
    }

    parm {
        name    "en_inst_force"
        label   "Enable"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    groupcollapsible {
        name    "grp_inst_force"
        label   "Force Instancer"
        parmtag { "sidefx::header_toggle" "en_inst_force" }

        parm {
            name    "inst_force_heading"
            label   "Heading"
            type    label
            default { "unreal_force_instancer" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "inst_force_help"
            label   "Help"
            type    label
            default { "说明：是否强制生成 Instancer 组件，即使只有一个实例。可通过 Attribute 或数值指定。\n示例(Attribute)：来源 attr=1 → 写出 unreal_force_instancer=1。\n示例(数值)：直接设置=0 → UE 自动决定是否创建 Instancer。\n结果：控制 Instancer 生成逻辑。\nOwner：Any。" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "owner_inst_force"
            label   "Attribute Owner"
            type    ordinal
            nolabel
            joinnext
            default { "detail" }
            disablewhen "{ en_inst_force == 0 }"
            menu {
                "point"     "Point"
                "vertex"    "Vertex"
                "prim"      "Prim"
                "detail"    "Detail"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "form_mode_inst_force"
            label   "Form Mode"
            type    ordinal
            nolabel
            default { "value" }
            disablewhen "{ en_inst_force == 0 }"
            menu {
                "attrib"    "Attribute"
                "value"     "Value"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "inst_force_from"
            label   "Attribute From"
            type    string
            default { "unreal_force_instancer" }
            disablewhen "{ en_inst_force == 0 } { form_mode_inst_force != attrib }"
            menureplace {
                [ "node = hou.pwd()" ]
                [ "owner = node.parm(\"owner_inst_force\").evalAsString()" ]
                [ "" ]
                [ "in_node = node.node(\"IN\")" ]
                [ "if not in_node:" ]
                [ "    return []" ]
                [ "" ]
                [ "geo = in_node.geometry()" ]
                [ "attrs = []" ]
                [ "" ]
                [ "if owner == \"point\":" ]
                [ "    attrs = [a.name() for a in geo.pointAttribs()]" ]
                [ "elif owner == \"prim\":" ]
                [ "    attrs = [a.name() for a in geo.primAttribs()]" ]
                [ "elif owner == \"vertex\":" ]
                [ "    attrs = [a.name() for a in geo.vertexAttribs()]" ]
                [ "elif owner == \"detail\":" ]
                [ "    attrs = [a.name() for a in geo.globalAttribs()]" ]
                [ "" ]
                [ "menu = []" ]
                [ "for a in attrs:" ]
                [ "    menu += [a, a]" ]
                [ "" ]
                [ "return menu" ]
                language python
            }
            parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'owner_inst_force')" }
            parmtag { "menu_script_language" "python" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "inst_force_val"
            label   "Force Instancer"
            type    toggle
            default { "0" }
            disablewhen "{ en_inst_force == 0 } { form_mode_inst_force != value }"
            parmtag { "script_callback_language" "python" }
        }
    }

    parm {
        name    "en_inst_numfloats"
        label   "Enable"
