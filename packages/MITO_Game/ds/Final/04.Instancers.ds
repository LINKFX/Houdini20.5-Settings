                "prim"      "Prim"
                "detail"    "Detail"
            }
            parmtag { "script_callback_language" "python" }
        }
        multiparm {
            name    "num_inst_customdata"
            label    "Number of Custom Data"

            parm {
                name    "inst_customdata_val#"
                label   "Custom Data Value #"
                type    float
                default { "0" }
                disablewhen "{ en_inst_customdata == 0 }"
                range   { 0 10 }
                parmtag { "script_callback_language" "python" }
            }
        }

