{
    name	selectedparms

    parm {
        name    "en_inst_instance"
        label   "Enable"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    groupcollapsible {
        name    "grp_inst_instance"
        label   "Unreal Instance"
        parmtag { "group_default" "0" }
        parmtag { "sidefx::header_toggle" "en_inst_instance" }

        parm {
            name    "inst_instance_heading"
            label   "Heading"
            type    label
            default { "unreal_instance" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "inst_instance_help"
            label   "Help"
            type    label
            default { "说明：指定实例化的目标资源路径（或类名）。可通过 Attribute 或直接输入路径。\n示例(Attribute)：来源 attr=/Game/Props/SM_Chair → 写出 unreal_instance=/Game/Props/SM_Chair。\n示例(数值)：直接输入 Blueprint'/Game/BP/BP_Light.BP_Light_C' → UE 中实例化该蓝图类。\n结果：Bake 时会在 UE 场景中生成对应的实例化对象。\nOwner：Point/Detail。" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "owner_inst_instance"
            label   "Attribute Owner"
            type    ordinal
            nolabel
            joinnext
            default { "point" }
            disablewhen "{ en_inst_instance == 0 }"
            menu {
                "point"     "Point"
                "detail"    "Detail"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "form_mode_inst_instance"
            label   "Form Mode"
            type    ordinal
            nolabel
            default { "value" }
            disablewhen "{ en_inst_instance == 0 }"
            menu {
                "attrib"    "Attribute"
                "value"     "Value"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "inst_instance_from"
            label   "Attribute From"
            type    string
            default { "unreal_instance" }
            disablewhen "{ en_inst_instance == 0 } { form_mode_inst_instance != attrib }"
            menureplace {
                [ "node = hou.pwd()" ]
                [ "owner = node.parm(\"owner_inst_instance\").evalAsString()" ]
                [ "" ]
                [ "in_node = node.node(\"IN\")" ]
                [ "if not in_node:" ]
                [ "    return []" ]
                [ "" ]
                [ "geo = in_node.geometry()" ]
                [ "attrs = []" ]
                [ "" ]
                [ "if owner == \"point\":" ]
                [ "    attrs = [a.name() for a in geo.pointAttribs()]" ]
                [ "elif owner == \"prim\":" ]
                [ "    attrs = [a.name() for a in geo.primAttribs()]" ]
                [ "elif owner == \"vertex\":" ]
                [ "    attrs = [a.name() for a in geo.vertexAttribs()]" ]
                [ "elif owner == \"detail\":" ]
                [ "    attrs = [a.name() for a in geo.globalAttribs()]" ]
                [ "" ]
                [ "menu = []" ]
                [ "for a in attrs:" ]
                [ "    menu += [a, a]" ]
                [ "" ]
                [ "return menu" ]
                language python
            }
            parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'owner_inst_instance')" }
            parmtag { "menu_script_language" "python" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "inst_instance_val"
            label   "Instance Path"
            type    string
            default { "/Game/Props/SM_Chair" }
            disablewhen "{ en_inst_instance == 0 } { form_mode_inst_instance != value }"
            parmtag { "script_callback_language" "python" }
        }
    }

    parm {
        name    "en_inst_foliage"
        label   "Enable"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    groupcollapsible {
        name    "grp_inst_foliage"
        label   "Unreal Foliage"
        parmtag { "group_default" "0" }
        parmtag { "sidefx::header_toggle" "en_inst_foliage" }

        parm {
            name    "inst_foliage_heading"
            label   "Heading"
            type    label
            default { "unreal_foliage" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "inst_foliage_help"
            label   "Help"
            type    label
            default { "说明：指定实例化对象是否作为 Foliage（植被系统）导入。可通过 Attribute 或数值指定。\n示例(Attribute)：来源 attr=1 → 写出 unreal_foliage=1，UE 中实例被添加到植被系统。\n示例(数值)：直接设置 Foliage=0 → UE 中实例按普通 Actor 放置。\n结果：控制实例是否加入 UE 的 Foliage 系统。\nOwner：Detail/Prim/Point。" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "owner_inst_foliage"
            label   "Attribute Owner"
            type    ordinal
            nolabel
            joinnext
            default { "point" }
            disablewhen "{ en_inst_foliage == 0 }"
            menu {
                "point"     "Point"
                "prim"      "Prim"
                "detail"    "Detail"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "form_mode_inst_foliage"
            label   "Form Mode"
            type    ordinal
            nolabel
            default { "value" }
            disablewhen "{ en_inst_foliage == 0 }"
            menu {
                "attrib"    "Attribute"
                "value"     "Value"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "inst_foliage_from"
            label   "Attribute From"
            type    string
            default { "unreal_foliage" }
            disablewhen "{ en_inst_foliage == 0 } { form_mode_inst_foliage != attrib }"
            menureplace {
                [ "node = hou.pwd()" ]
                [ "owner = node.parm(\"owner_inst_foliage\").evalAsString()" ]
                [ "" ]
                [ "in_node = node.node(\"IN\")" ]
                [ "if not in_node:" ]
                [ "    return []" ]
                [ "" ]
                [ "geo = in_node.geometry()" ]
                [ "attrs = []" ]
                [ "" ]
                [ "if owner == \"point\":" ]
                [ "    attrs = [a.name() for a in geo.pointAttribs()]" ]
                [ "elif owner == \"prim\":" ]
                [ "    attrs = [a.name() for a in geo.primAttribs()]" ]
                [ "elif owner == \"vertex\":" ]
                [ "    attrs = [a.name() for a in geo.vertexAttribs()]" ]
                [ "elif owner == \"detail\":" ]
                [ "    attrs = [a.name() for a in geo.globalAttribs()]" ]
                [ "" ]
                [ "menu = []" ]
                [ "for a in attrs:" ]
                [ "    menu += [a, a]" ]
                [ "" ]
                [ "return menu" ]
                language python
            }
            parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'owner_inst_foliage')" }
            parmtag { "menu_script_language" "python" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "inst_foliage_val"
            label   "Foliage Enabled"
            type    toggle
            default { "1" }
            disablewhen "{ en_inst_foliage == 0 } { form_mode_inst_foliage != value }"
            parmtag { "script_callback_language" "python" }
        }
    }

    parm {
        name    "en_inst_foliage_type"
        label   "Enable"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    groupcollapsible {
        name    "grp_inst_foliage_type"
        label   "Unreal Foliage Attachment Type"
        parmtag { "sidefx::header_toggle" "en_inst_foliage_type" }

        parm {
            name    "inst_foliage_type_heading"
            label   "Heading"
            type    label
            default { "unreal_foliage_attachment_type" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "inst_foliage_type_help"
            label   "Help"
            type    label
            default { "说明：指定植被实例附着方式。可通过 Attribute 或数值指定。\n示例(Attribute)：来源 attr=1 → 写出 unreal_foliage_attachment_type=1，UE 中植被附着到 Actor。\n示例(数值)：设置=2 → 植被附着到 Landscape。\n结果：决定植被系统中实例附着逻辑（0=不附着，1=附着Actor，2=附着Landscape）。\nOwner：Point。" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "owner_inst_foliage_type"
            label   "Attribute Owner"
            type    ordinal
            nolabel
            joinnext
            default { "point" }
            disablewhen "{ en_inst_foliage_type == 0 }"
            menu {
                "point" "Point"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "form_mode_inst_foliage_type"
            label   "Form Mode"
            type    ordinal
            nolabel
            default { "value" }
            disablewhen "{ en_inst_foliage_type == 0 }"
            menu {
                "attrib"    "Attribute"
                "value"     "Value"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "inst_foliage_type_from"
            label   "Attribute From"
            type    string
            default { "unreal_foliage_attachment_type" }
            disablewhen "{ en_inst_foliage_type == 0 } { form_mode_inst_foliage_type != attrib }"
            menureplace {
                [ "node = hou.pwd()" ]
                [ "owner = node.parm(\"owner_inst_foliage_type\").evalAsString()" ]
                [ "" ]
                [ "in_node = node.node(\"IN\")" ]
                [ "if not in_node:" ]
                [ "    return []" ]
                [ "" ]
                [ "geo = in_node.geometry()" ]
                [ "attrs = []" ]
                [ "" ]
                [ "if owner == \"point\":" ]
                [ "    attrs = [a.name() for a in geo.pointAttribs()]" ]
                [ "elif owner == \"prim\":" ]
                [ "    attrs = [a.name() for a in geo.primAttribs()]" ]
                [ "elif owner == \"vertex\":" ]
                [ "    attrs = [a.name() for a in geo.vertexAttribs()]" ]
                [ "elif owner == \"detail\":" ]
                [ "    attrs = [a.name() for a in geo.globalAttribs()]" ]
                [ "" ]
                [ "menu = []" ]
                [ "for a in attrs:" ]
                [ "    menu += [a, a]" ]
                [ "" ]
                [ "return menu" ]
                language python
            }
            parmtag { "menu_script" "return hou.phm().attr_from_menu(kwargs, 'owner_inst_foliage_type')" }
            parmtag { "menu_script_language" "python" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "inst_foliage_type_val"
            label   "Attachment Type"
            type    ordinal
            default { "0" }
            disablewhen "{ en_inst_foliage_type == 0 } { form_mode_inst_foliage_type != value }"
            menu {
                "not"                   "Not"
                "adhering_actor"        "Adhering Actor"
                "adhering_landscape"    "Adhering Landscape"
            }
            range   { 0 2 }
            parmtag { "script_callback_language" "python" }
        }
    }

    parm {
        name    "en_inst_foliage_dist"
        label   "Enable"
        type    toggle
        default { "0" }
        parmtag { "script_callback_language" "python" }
    }
    groupcollapsible {
        name    "grp_inst_foliage_dist"
        label   "Unreal Foliage Attachment Distance"
        parmtag { "sidefx::header_toggle" "en_inst_foliage_dist" }

        parm {
            name    "inst_foliage_dist_heading"
            label   "Heading"
            type    label
            default { "unreal_foliage_attachment_distance" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "inst_foliage_dist_help"
            label   "Help"
            type    label
            default { "说明：设置植被附着时的垂直搜索距离。可通过 Attribute 或数值指定。\n示例(Attribute)：来源 attr=500 → 写出 unreal_foliage_attachment_distance=500。\n示例(数值)：直接输入 1000 → UE 中按 1000cm 搜索。\n结果：控制植被系统在附着时的垂直范围。\nOwner：Point。" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "owner_inst_foliage_dist"
            label   "Attribute Owner"
            type    ordinal
            nolabel
            joinnext
            default { "point" }
            disablewhen "{ en_inst_foliage_dist == 0 }"
            menu {
                "point" "Point"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "form_mode_inst_foliage_dist"
            label   "Form Mode"
            type    ordinal
            nolabel
            default { "value" }
            disablewhen "{ en_inst_foliage_dist == 0 }"
            menu {
