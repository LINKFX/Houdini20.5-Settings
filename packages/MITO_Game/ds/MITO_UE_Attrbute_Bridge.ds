                parmtag { "script_callback_language" "python" }
            }
            groupcollapsible {
                name    "grp_smoothmask"
                label   "Unreal Face Smoothing Mask"
                parmtag { "group_default" "0" }
                grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/5.0_Material_Main.ds" }
                grouptag { "import_token" "grp_smoothmask:Unreal Face Smoothing Mask" }
                parmtag { "sidefx::header_toggle" "en_smoothmask" }

                parm {
                    name    "smoothmask_heading"
                    label   "Heading"
                    type    label
                    default { "unreal_face_smoothing_mask" }
                    parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/5.0_Material_Main.ds" }
                    parmtag { "import_token" "smoothmask_heading" }
                    parmtag { "sidefx::look" "heading" }
                }
                parm {
                    name    "smoothmask_help"
                    label   "Help"
                    type    label
                    default { "说明：用于定义网格平滑组。相同数值的面在 UE 中光滑过渡，不同数值则会产生硬边。可从来源整型属性重命名为 unreal_face_smoothing_mask，或直接输入数值。\n示例(属性)：来源 mask=2 → 实际写出 unreal_face_smoothing_mask=2，mask 被移除。\n示例(数值)：直接设置 unreal_face_smoothing_mask=1。\n结果：相同值的面在 UE 中光滑，不同值的面形成硬边。\nOwner：Prim。" }
                    parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/5.0_Material_Main.ds" }
                    parmtag { "import_token" "smoothmask_help" }
                    parmtag { "sidefx::look" "heading" }
                }
                parm {
                    name    "owner_smoothmask"
                    label   "Attribute Owner"
                    type    ordinal
                    nolabel
                    joinnext
                    default { "prim" }
                    disablewhen "{ en_smoothmask == 0 }"
                    menu {
                        "prim"  "Prim"
                    }
                    parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/5.0_Material_Main.ds" }
                    parmtag { "import_token" "owner_smoothmask" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "form_mode_smoothmask"
                    label   "Form Mode"
                    type    ordinal
                    nolabel
                    default { "value" }
                    disablewhen "{ en_smoothmask == 0 }"
                    menu {
                        "attrib"    "Attribute"
                        "value"     "Value"
                    }
                    parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/5.0_Material_Main.ds" }
                    parmtag { "import_token" "form_mode_smoothmask" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "smoothmask_from"
                    label   "Attribute From"
                    type    string
                    default { "" }
                    disablewhen "{ en_smoothmask == 0 } { form_mode_smoothmask != attrib }"
                    menutoggle {
                        [ " opmenu -l -a attribute primdel " ]
                    }
                    parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/5.0_Material_Main.ds" }
                    parmtag { "import_token" "smoothmask_from" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "smoothmask_val"
                    label   "Mask Value"
                    type    integer
                    default { "1" }
                    disablewhen "{ en_smoothmask == 0 } { form_mode_smoothmask != value }"
                    range   { 0 10 }
                    parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/5.0_Material_Main.ds" }
                    parmtag { "import_token" "smoothmask_val" }
                    parmtag { "script_callback_language" "python" }
                }
            }

