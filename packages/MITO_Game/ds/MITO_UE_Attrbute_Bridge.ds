    group {
        name    "folder5_1"
        label   "2_Generic_UProperty"

        multiparm {
            name    "numattr"
            label    "Number of Attributes"
            default 0
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "autoselect" "0000000000000000" }

            parm {
                name    "enable#"
                label   "Enable"
                type    toggle
                nolabel
                joinnext
                default { "0" }
            }
            parm {
                name    "name_disp_#"
                label   "Name"
                type    string
                default { "(UE)Parameter_Name#" }
                disablewhen "{ enable# == 0 }"
            }
            parm {
                name    "name#"
                label   "Name"
                type    string
                invisible
                default { "unreal_uproperty_`chs(\"name_disp_#\")`" }
                disablewhen "{ enable# == 0 }"
            }
            parm {
                name    "existing#"
                label   "Existing Name"
                type    ordinal
                invisible
                default { "3" }
                disablewhen "{ enable# == 0 }"
                menu {
                    "error"     "Generate error on mis-matched attribute"
                    "warn"      "Generate warning on mis-matched attribute"
                    "replace"   "Replace existing attribute"
                    "better"    "Use the better type, size and precision"
                }
            }
            parm {
                name    "createvarmap#"
                label   "Create Variable Mapping"
                type    toggle
                invisible
                nolabel
                joinnext
                default { "0" }
                disablewhen "{ enable# == 0 }"
            }
            parm {
                name    "varname#"
                label   "Local Variable"
                type    string
                invisible
                default { "" }
                disablewhen "{ enable# == 0 } { createvarmap# == 0 }"
            }
            parm {
                name    "class#"
                label   "Class"
                type    ordinal
                joinnext
                default { "2" }
                disablewhen "{ enable# == 0 }"
                menu {
                    "detail"    "Detail"
                    "primitive" "Primitive"
                    "point"     "Point"
                }
            }
            parm {
                name    "savetoinfo#"
                label   "Save to Info Block"
                type    toggle
                invisible
                default { "0" }
                disablewhen "{ enable# == 0 } { class# != detail }"
            }
            parm {
                name    "type#"
                label   "Type"
                type    ordinal
                joinnext
                default { "0" }
                disablewhen "{ enable# == 0 }"
                menu {
                    "float"         "Float"
                    "int"           "Integer"
                    "vector"        "Vector"
                    "index"         "String"
                    "floatarray"    "Float Array"
                    "intarray"      "Integer Array"
                    "stringarray"   "String Array"
                    "dict"          "Dictionary"
                    "dictarray"     "Dictionary Array"
                }
            }
            parm {
                name    "typeinfo#"
                label   "Type Qualifier"
                type    ordinal
                invisible
                nolabel
                default { "0" }
                disablewhen "{ enable# == 0 }"
                hidewhen "{ type# != float type# != floatarray }"
                menu {
                    "guess"         "Guess from name"
                    "none"          "None"
                    "point"         "Position"
                    "vector"        "Vector"
                    "normal"        "Normal"
                    "color"         "Color"
                    "quaternion"    "Quaternion"
                    "tranform"      "Transform Matrix"
                    "texturecoord"  "Texture Coordinate"
                }
            }
            parm {
                name    "precision#"
                label   "Precision"
                type    ordinal
                invisible
                default { "4" }
                disablewhen "{ enable# == 0 }"
                hidewhen "{ type# == index } { type# == stringarray } { type# == dict } { type# == dictarray }"
                menu {
                    "8"     "8-bit"
                    "16"    "16-bit"
                    "32"    "32-bit"
                    "64"    "64-bit"
                    "auto"  "Auto"
                }
            }
            parm {
                name    "size#"
                label   "Size"
                type    integer
                default { "1" }
                disablewhen "{ enable# == 0 }"
                hidewhen "{ type# == vector } { type# == index }"
                range   { 1! 4 }
            }
            parm {
                name    "default#"
                label   "Default"
                type    float
                invisible
                size    4
                default { "0" "0" "0" "0" }
                disablewhen "{ enable# == 0 }"
                hidewhen "{ type# == index } { type# == floatarray } { type# == intarray } { type# == stringarray } { type# == dict } { type# == dictarray }"
                range   { 0 10 }
            }
            parm {
                name    "writevalues#"
                label   "Write Values"
                type    toggle
                invisible
                joinnext
                default { "1" }
                disablewhen "{ enable# == 0 }"
                hidewhen "{ type# == floatarray } { type# == intarray } { type# == stringarray } { type# == dict } { type# == dictarray }"
            }
            parm {
                name    "uselocal#"
                label   "Allow Local Vars"
                type    toggle
                invisible
                default { "1" }
                disablewhen "{ enable# == 0 } { writevalues# == 0 }"
                hidewhen "{ type# == floatarray } { type# == intarray } { type# == stringarray } { type# == dict } { type# == dictarray }"
            }
            parm {
                name    "value#v"
                label   "Value"
                type    float
                size    4
                default { "0" "0" "0" "0" }
                disablewhen "{ enable# == 0 }"
                hidewhen "{ writevalues# == 0 } { type# != float type# != int type# != vector }"
                range   { 0 10 }
            }
            parm {
                name    "string#"
                label   "String"
                type    string
                default { "" }
                disablewhen "{ enable# == 0 }"
                hidewhen "{ writevalues# == 0 } { type# != index }"
            }
            parm {
                name    "numattr_spacerparm#"
                label   "Spacer"
                type    separator
                default { "" }
                parmtag { "sidefx::layout_height" "small" }
                parmtag { "sidefx::look" "blank" }
            }
        }

    }

    group {
