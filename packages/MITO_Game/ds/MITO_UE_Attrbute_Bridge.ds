        group {
            name    "folder2_2"
            label   "Material Parameter"
            grouptag { "group_default" "0" }
            grouptag { "sidefx::header_toggle" "en_matparam" }

            parm {
                name    "matparam_heading"
                label   "Heading"
                type    label
                default { "unreal_material_parameter_*" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "matparam_help"
                label   "Help"
                type    label
                default { "说明：创建以 unreal_material_parameter_ 为前缀的属性，用于控制生成材质实例的参数。\n只需输入参数名，前缀会自动加上。\n* 为具体参数名（如 Color、Roughness、Metallic 等）。类型需与材质中对应参数一致（float、int、vector、string、array）。\n\n示例：\n- Color=(1,0,0) → 实际写出 unreal_material_parameter_Color=(1,0,0)，设置实例中颜色参数为红色。\n- Roughness=0.5 → 实际写出 unreal_material_parameter_Roughness=0.5，设置粗糙度为 0.5。\n\n结果：生成的材质实例在 UE 中会自动应用这些参数值。\nOwner：Detail。" }
                parmtag { "sidefx::look" "heading" }
            }
            multiparm {
                name    "numattr2"
                label    "Number of Attributes"
                default 0
                parmtag { "autoscope" "0000000000000000" }

                parm {
                    name    "enable1_#"
                    label   "Enable"
                    type    toggle
                    nolabel
                    joinnext
                    default { "1" }
                }
                parm {
                    name    "name_disp1_#"
                    label   "Name"
                    type    string
                    default { "Mat_Parameter_Name#" }
                    disablewhen "{ enable1_# == 0 }"
                }
                parm {
                    name    "name1_#"
                    label   "Name"
                    type    string
                    invisible
                    default { "unreal_uproperty_`chs(\"name_disp1_#\")`" }
                    disablewhen "{ enable1_# == 0 }"
                }
                parm {
                    name    "existing1_#"
                    label   "Existing Name"
                    type    ordinal
                    invisible
                    default { "3" }
                    disablewhen "{ enable1_# == 0 }"
                    menu {
                        "error"     "Generate error on mis-matched attribute"
                        "warn"      "Generate warning on mis-matched attribute"
                        "replace"   "Replace existing attribute"
                        "better"    "Use the better type, size and precision"
                    }
                }
                parm {
                    name    "createvarmap1_#"
                    label   "Create Variable Mapping"
                    type    toggle
                    invisible
                    nolabel
                    joinnext
                    default { "0" }
                    disablewhen "{ enable1_# == 0 }"
                }
                parm {
                    name    "varname1_#"
                    label   "Local Variable"
                    type    string
                    invisible
                    default { "" }
                    disablewhen "{ enable1_# == 0 } { createvarmap1_# == 0 }"
                }
                parm {
                    name    "class1_#"
                    label   "Class"
                    type    ordinal
                    joinnext
                    default { "0" }
                    disablewhen "{ enable1_# == 0 }"
                    menu {
                        "detail"    "Detail"
                    }
                }
                parm {
                    name    "savetoinfo1_#"
                    label   "Save to Info Block"
                    type    toggle
                    invisible
                    default { "0" }
                    disablewhen "{ enable1_# == 0 } { class1_# != detail }"
                }
                parm {
                    name    "type1_#"
                    label   "Type"
                    type    ordinal
                    joinnext
                    default { "0" }
                    disablewhen "{ enable1_# == 0 }"
                    menu {
                        "float"         "Float"
                        "int"           "Integer"
                        "vector"        "Vector"
                        "index"         "String"
                        "floatarray"    "Float Array"
                        "intarray"      "Integer Array"
                        "stringarray"   "String Array"
                        "dict"          "Dictionary"
                        "dictarray"     "Dictionary Array"
                    }
                }
                parm {
                    name    "typeinfo1_#"
                    label   "Type Qualifier"
                    type    ordinal
                    nolabel
                    default { "0" }
                    disablewhen "{ enable1_# == 0 }"
                    hidewhen "{ type1_# != float type1_# != floatarray }"
                    menu {
                        "guess"         "Guess from name"
                        "none"          "None"
                        "point"         "Position"
                        "vector"        "Vector"
                        "normal"        "Normal"
                        "color"         "Color"
                        "quaternion"    "Quaternion"
                        "tranform"      "Transform Matrix"
                        "texturecoord"  "Texture Coordinate"
                    }
                }
                parm {
                    name    "precision1_#"
                    label   "Precision"
                    type    ordinal
                    invisible
                    default { "4" }
                    disablewhen "{ enable1_# == 0 }"
                    hidewhen "{ type1_# == index } { type1_# == stringarray } { type1_# == dict } { type1_# == dictarray }"
                    menu {
                        "8"     "8-bit"
                        "16"    "16-bit"
                        "32"    "32-bit"
                        "64"    "64-bit"
                        "auto"  "Auto"
                    }
                }
                parm {
                    name    "size1_#"
                    label   "Size"
                    type    integer
                    default { "1" }
                    disablewhen "{ enable1_# == 0 }"
                    hidewhen "{ type1_# == vector } { type1_# == index }"
                    range   { 1! 4 }
                }
                parm {
                    name    "default1_#"
                    label   "Default"
                    type    float
                    invisible
                    size    4
                    default { "0" "0" "0" "0" }
                    disablewhen "{ enable1_# == 0 }"
                    hidewhen "{ type1_# == index } { type1_# == floatarray } { type1_# == intarray } { type1_# == stringarray } { type1_# == dict } { type1_# == dictarray }"
                    range   { 0 10 }
                }
                parm {
                    name    "writevalues1_#"
                    label   "Write Values"
                    type    toggle
                    invisible
                    joinnext
                    default { "1" }
                    disablewhen "{ enable1_# == 0 }"
                    hidewhen "{ type1_# == floatarray } { type1_# == intarray } { type1_# == stringarray } { type1_# == dict } { type1_# == dictarray }"
                }
                parm {
                    name    "uselocal1_#"
                    label   "Allow Local Vars"
                    type    toggle
                    invisible
                    default { "1" }
                    disablewhen "{ enable1_# == 0 } { writevalues1_# == 0 }"
                    hidewhen "{ type1_# == floatarray } { type1_# == intarray } { type1_# == stringarray } { type1_# == dict } { type1_# == dictarray }"
                }
                parm {
                    name    "value1_#"
                    label   "Value"
                    type    float
                    size    4
                    default { "0" "0" "0" "0" }
                    disablewhen "{ enable1_# == 0 }"
                    hidewhen "{ writevalues1_# == 0 } { type1_# != float type1_# != int type1_# != vector }"
                    range   { 0 10 }
                }
                parm {
                    name    "string1_#"
                    label   "String"
                    type    string
                    default { "" }
                    disablewhen "{ enable1_# == 0 }"
                    hidewhen "{ writevalues1_# == 0 } { type1_# != index }"
                }
                parm {
                    name    "numattr_spacerparm#_2"
                    label   "Spacer"
                    type    separator
                    invisible
                    default { "" }
                    parmtag { "sidefx::layout_height" "small" }
                    parmtag { "sidefx::look" "blank" }
                }
            }

        }

    }

