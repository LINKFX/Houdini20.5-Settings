                    default { "说明：为 Segment 指定一个静态网格和多个材质覆盖。\n- 属性模式：从数组属性读取，第一个元素是 Mesh 路径，后续是材质覆盖路径。\n- 数值模式：直接指定 Mesh 路径，并可添加多个材质覆盖。\n示例(属性)：来源 arr=[/Game/SM_Road, /Game/MI_Asphalt, /Game/MI_RoadEdge] →\n  unreal_landscape_spline_segment_mesh0=/Game/SM_Road\n  unreal_landscape_spline_segment_mesh0_material_override0=/Game/MI_Asphalt\n  unreal_landscape_spline_segment_mesh0_material_override1=/Game/MI_RoadEdge\n示例(数值)：Mesh=/Game/SM_Road + Overrides=/Game/MI_Asphalt。\n结果：Segment 使用指定 Mesh，并用材质覆盖替换槽。\nOwner：Point/Vertex/Prim。" }
                    parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                    parmtag { "import_token" "seg_mesh_help" }
                    parmtag { "sidefx::look" "heading" }
                }
                parm {
                    name    "owner_seg_mesh"
                    label   "Attribute Owner"
                    type    ordinal
                    nolabel
                    joinnext
                    default { "prim" }
                    disablewhen "{ en_seg_mesh == 0 }"
                    menu {
                        "point"     "Point"
                        "vertex"    "Vertex"
                        "prim"      "Prim"
                    }
                    parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                    parmtag { "import_token" "owner_seg_mesh" }
                    parmtag { "script_callback_language" "python" }
