                    default { "说明：可从来源浮点属性重命名为 unreal_landscape_spline_side_falloff，或直接指定数值。\n示例(属性)：来源 a=128.0 → 实际写出 unreal_landscape_spline_side_falloff=128.0，a 被移除。\n示例(数值)：直接设置 unreal_landscape_spline_side_falloff=128.0。\n结果：指定样条的 Side Falloff 范围。\nOwner：Point/Vertex。" }
                    parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.3_Landscape_Splines_ControlPoint.ds" }
                    parmtag { "import_token" "cp_sidefalloff_help" }
                    parmtag { "sidefx::look" "heading" }
                }
                parm {
                    name    "owner_cp_sidefalloff"
                    label   "Attribute Owner"
