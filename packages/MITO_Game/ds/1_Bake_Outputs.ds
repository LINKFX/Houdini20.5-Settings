        parm {
            name    "en_level_path"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            parmtag { "import_token" "en_level_path" }
            parmtag { "script_callback_language" "python" }
        }
        groupcollapsible {
            name    "grp_level_path"
            label   "Level Path"
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            grouptag { "import_token" "grp_level_path:Level Path" }
            parmtag { "sidefx::header_parm" "level_path_str" }
            parmtag { "sidefx::header_toggle" "en_level_path" }

            parm {
                name    "level_path_heading"
                label   "Heading"
                type    label
                default { "unreal_level_path" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "level_path_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "level_path_help_heading"
                label   "Help"
                type    label
                default { "说明：指定 Bake 的目标关卡路径；Meshes/Instancers/Foliage/Landscape 将烘焙到该 Level。支持字符串 Token（如 {world}，在运行时替换为当前世界名）。 \n示例：{world}/SubLevels/Generated → 实际写出 unreal_level_path={world}/SubLevels/Generated。 \n结果：Bake 输出被写入到指定子关卡（若不存在可按工具逻辑创建/引用）。 \nOwner：Point/Prim/Detail。 " }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "level_path_help_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_level_path"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "point" }
                disablewhen "{ en_level_path == 0 }"
                menu {
                    "point"     "Point"
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "owner_level_path" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "level_path_str"
                label   "Level Path"
                type    string
                default { "{world}/SubLevels/Generated" }
                disablewhen "{ en_level_path == 0 }"
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "level_path_str" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_bake_folder"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            parmtag { "import_token" "en_bake_folder" }
            parmtag { "script_callback_language" "python" }
        }
        groupcollapsible {
            name    "grp_bake_folder"
            label   "Bake Folder"
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            grouptag { "import_token" "grp_bake_folder:Bake Folder" }
            parmtag { "sidefx::header_parm" "bake_folder_str" }
            parmtag { "sidefx::header_toggle" "en_bake_folder" }

            parm {
                name    "bake_folder_heading"
                label   "Heading"
                type    label
                default { "unreal_bake_folder" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "bake_folder_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "bake_folder_help_heading"
                label   "Help"
                type    label
                default { "说明：覆盖默认 Bake 的内容浏览器文件夹路径（Content Path）。支持字符串 Token（如 {bake}，在项目中统一到 Bake 根）。 \n示例：/Game/Bake/Generated → 实际写出 unreal_bake_folder=/Game/Bake/Generated。 \n结果：烘焙生成/归档的资源被写入该内容目录。 \nOwner：Prim/Detail。 " }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "bake_folder_help_heading" }
                parmtag { "sidefx::look" "heading" }
