                type    string
                default { "/Game/Bake/Generated" }
                disablewhen "{ en_bake_folder == 0 }"
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
