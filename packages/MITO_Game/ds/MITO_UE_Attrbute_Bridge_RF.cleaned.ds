{
    name	selectedparms

    parm {
        name    "en_output_name"
        label   "Enable"
        type    toggle
        default { "0" }
    }
    groupcollapsible {
        name    "grp_output_name"
        label   "Output Name"
        parmtag { "group_default" "0" }
        parmtag { "sidefx::header_parm" "output_name_str" }
        parmtag { "sidefx::header_toggle" "en_output_name" }

        parm {
            name    "output_name_heading"
            label   "Heading"
            type    label
            default { "unreal_output_name" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "output_name_help_heading"
            label   "Help"
            type    label
            default { "说明：统一控制 Bake 输出的命名（Actor/资源/图层等）。支持字符串 Token（如 {world}、{bake}、{actor}），在运行时展开为项目上下文。\n示例：SM_Bridge_01 → 实际写出 unreal_output_name=SM_Bridge_01。\n结果：后续管线统一使用该名称创建或匹配目标对象（也替代旧字段 unreal_bake_name、unreal_landscape_editlayer_target）。\nOwner：Point/Prim/Detail。" }
            parmtag { "sidefx::look" "heading" }
        }
        parm {
            name    "owner_output_name"
            label   "Attribute Owner"
            type    ordinal
            nolabel
            joinnext
            default { "prim" }
            disablewhen "{ en_output_name == 0 }"
            menu {
                "point"     "Point"
                "prim"      "Prim"
                "detail"    "Detail"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "output_name_str"
            label   "Name"
            type    string
            default { "OutputName" }
            disablewhen "{ en_output_name == 0 }"
            parmtag { "script_callback_language" "python" }
        }
    }

    group {
        name    "folder5"
        label   "1_Bake_Outputs"
        grouptag { "import_enable" "1" }
        grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }

        parm {
            name    "en_tag_generic"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            parmtag { "import_token" "en_tag_generic" }
        }
        groupcollapsible {
            name    "grp_tag_generic"
            label   "Generic Tag"
            parmtag { "group_default" "0" }
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            grouptag { "import_token" "grp_tag_generic:Generic Tag" }
            parmtag { "sidefx::header_parm" "tag_generic_csv" }
            parmtag { "sidefx::header_toggle" "en_tag_generic" }

            parm {
                name    "tag_generic_heading"
                label   "Heading"
                type    label
                default { "unreal_uproperty_tag_*" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "tag_generic_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "tag_generic_help_heading"
                label   "Help"
                type    label
                default { "说明：为 Actor/组件写入通用 Tags（CSV 展开为数组），用于运行时检索与过滤。 \n示例：Gameplay,Generated → 实际写出 unreal_uproperty_tag_0=Gameplay，unreal_uproperty_tag_1=Generated。 \n结果：Bake 后对象（Actor/组件）将带有这些通用标签，便于蓝图/关卡过滤。 \nOwner：Point/Prim/Detail。 " }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "tag_generic_help_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_tag_generic"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "point" }
                disablewhen "{ en_tag_generic == 0 }"
                menu {
                    "point"     "Point"
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "owner_tag_generic" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "tag_generic_csv"
                label   "Tags (CSV)"
                type    string
                default { "Gameplay,Generated" }
                disablewhen "{ en_tag_generic == 0 }"
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "tag_generic_csv" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_tag_actor"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            parmtag { "import_token" "en_tag_actor" }
        }
        groupcollapsible {
            name    "grp_tag_actor"
            label   "Actor Tag"
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            grouptag { "import_token" "grp_tag_actor:Actor Tag" }
            parmtag { "sidefx::header_parm" "tag_actor_csv" }
            parmtag { "sidefx::header_toggle" "en_tag_actor" }

            parm {
                name    "tag_actor_heading"
                label   "Heading"
                type    label
                default { "unreal_uproperty_actorTag_*" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "tag_actor_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "tag_actor_help_heading"
                label   "Help"
                type    label
                default { "说明：仅给 Actor 本体添加 Tags（CSV 展开为数组），用于关卡/脚本中的 Actor 级过滤。 \n示例：Boss,Quest → 实际写出 unreal_uproperty_actorTag_0=Boss，unreal_uproperty_actorTag_1=Quest。 \n结果：Bake 的 Actor 自身拥有这些标签。 \nOwner：Point/Prim/Detail。 " }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "tag_actor_help_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_tag_actor"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "point" }
                disablewhen "{ en_tag_actor == 0 }"
                menu {
                    "point"     "Point"
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "owner_tag_actor" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "tag_actor_csv"
                label   "Tags (CSV)"
                type    string
                default { "Boss,Quest" }
                disablewhen "{ en_tag_actor == 0 }"
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "tag_actor_csv" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_tag_comp"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            parmtag { "import_token" "en_tag_comp" }
        }
        groupcollapsible {
            name    "grp_tag_comp"
            label   "Component Tag"
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            grouptag { "import_token" "grp_tag_comp:Component Tag" }
            parmtag { "sidefx::header_parm" "tag_comp_csv" }
            parmtag { "sidefx::header_toggle" "en_tag_comp" }

            parm {
                name    "tag_comp_heading"
                label   "Heading"
                type    label
                default { "unreal_uproperty_componentTag_*" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "tag_comp_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "tag_comp_help_heading"
                label   "Help"
                type    label
                default { "说明：为所有组件添加 Tags（不含 Actor 本体），CSV 展开为数组。 \n示例：LOD,Proxy → 实际写出 unreal_uproperty_componentTag_0=LOD，unreal_uproperty_componentTag_1=Proxy。 \n结果：Bake 后每个组件带有这些标签，便于组件级过滤或自动化脚本。 \nOwner：Point/Prim/Detail。 " }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "tag_comp_help_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_tag_comp"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "point" }
                disablewhen "{ en_tag_comp == 0 }"
                menu {
                    "point"     "Point"
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "owner_tag_comp" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "tag_comp_csv"
                label   "Tags (CSV)"
                type    string
                default { "LOD,Proxy" }
                disablewhen "{ en_tag_comp == 0 }"
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "tag_comp_csv" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_tag_main"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            parmtag { "import_token" "en_tag_main" }
        }
        groupcollapsible {
            name    "grp_tag_main"
            label   "Main Component Tag"
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            grouptag { "import_token" "grp_tag_main:Main Component Tag" }
            parmtag { "sidefx::header_parm" "tag_main_csv" }
            parmtag { "sidefx::header_toggle" "en_tag_main" }

            parm {
                name    "tag_main_heading"
                label   "Heading"
                type    label
                default { "unreal_uproperty_mainComponentTag_*" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "tag_main_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "tag_main_help_heading"
                label   "Help"
                type    label
                default { "说明：仅给主组件（Root/Main Component）添加 Tags，CSV 展开为数组。 \n示例：RootOnly → 实际写出 unreal_uproperty_mainComponentTag_0=RootOnly。 \n结果：仅在根组件设置标签，便于对根组件识别与过滤。 \nOwner：Point/Prim/Detail。 " }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "tag_main_help_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_tag_main"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "point" }
                disablewhen "{ en_tag_main == 0 }"
                menu {
                    "point"     "Point"
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "owner_tag_main" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "tag_main_csv"
                label   "Tags (CSV)"
                type    string
                default { "RootOnly" }
                disablewhen "{ en_tag_main == 0 }"
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "tag_main_csv" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_curve"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            parmtag { "import_token" "en_curve" }
        }
        groupcollapsible {
            name    "grp_curve"
            label   "Curve"
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            grouptag { "import_token" "grp_curve:Curve" }
            parmtag { "sidefx::header_toggle" "en_curve" }

            parm {
                name    "curve_heading"
                label   "Heading"
                type    label
                default { "unreal_output_curve" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "curve_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "curve_help_heading"
                label   "Help"
                type    label
                default { "说明：将对应 Prim 作为曲线输出（SplineComponent）。 \n示例：启用 → 实际写出 unreal_output_curve=1。 \n结果：Bake 为 SplineComponent，用于道路/轨迹等样条资产。 \nOwner：Prim。 " }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "curve_help_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_curve"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                default { "prim" }
                disablewhen "{ en_curve == 0 }"
                menu {
                    "prim"  "Prim"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "owner_curve" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_curve_lin"
            label   "Enable"
            type    toggle
            default { "ch(\"en_curve\")" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            parmtag { "import_token" "en_curve_lin" }
        }
        groupcollapsible {
            name    "grp_curve_lin"
            label   "Curve Linear"
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            grouptag { "import_token" "grp_curve_lin:Curve Linear" }
            parmtag { "sidefx::header_toggle" "en_curve_lin" }

            parm {
                name    "curve_lin_heading"
                label   "Heading"
                type    label
                default { "unreal_output_curve_linear" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "curve_lin_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "curve_lin_help_heading"
                label   "Help"
                type    label
                default { "说明：将样条插值设为线性段（非平滑样条）。 \n示例：启用 → 实际写出 unreal_output_curve_linear=1。 \n结果：样条以折线段插值。 \nOwner：Prim。 " }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "curve_lin_help_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_curve_lin"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                default { "prim" }
                disablewhen "{ en_curve_lin == 0 }"
                menu {
                    "prim"  "Prim"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "owner_curve_lin" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_curve_closed"
            label   "Enable"
            type    toggle
            default { "ch(\"en_curve\")" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            parmtag { "import_token" "en_curve_closed" }
        }
        groupcollapsible {
            name    "grp_curve_closed"
            label   "Curve Closed"
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            grouptag { "import_token" "grp_curve_closed:Curve Closed" }
            parmtag { "sidefx::header_toggle" "en_curve_closed" }

            parm {
                name    "curve_closed_heading"
                label   "Heading"
                type    label
                default { "unreal_output_curve_closed" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "curve_closed_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "curve_closed_help_heading"
                label   "Help"
                type    label
                default { "说明：将样条设为闭合（首尾相连）。 \n示例：启用 → 实际写出 unreal_output_curve_closed=1。 \n结果：用于环路/围栏等闭合结构。 \nOwner：Prim。 " }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "curve_closed_help_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_curve_closed"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                default { "prim" }
                disablewhen "{ en_curve_closed == 0 }"
                menu {
                    "prim"  "Prim"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "owner_curve_closed" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_level_path"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            parmtag { "import_token" "en_level_path" }
        }
        groupcollapsible {
            name    "grp_level_path"
            label   "Level Path"
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            grouptag { "import_token" "grp_level_path:Level Path" }
            parmtag { "sidefx::header_parm" "level_path_str" }
            parmtag { "sidefx::header_toggle" "en_level_path" }

            parm {
                name    "level_path_heading"
                label   "Heading"
                type    label
                default { "unreal_level_path" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "level_path_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "level_path_help_heading"
                label   "Help"
                type    label
                default { "说明：指定 Bake 的目标关卡路径；Meshes/Instancers/Foliage/Landscape 将烘焙到该 Level。支持字符串 Token（如 {world}，在运行时替换为当前世界名）。 \n示例：{world}/SubLevels/Generated → 实际写出 unreal_level_path={world}/SubLevels/Generated。 \n结果：Bake 输出被写入到指定子关卡（若不存在可按工具逻辑创建/引用）。 \nOwner：Point/Prim/Detail。 " }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "level_path_help_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_level_path"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "point" }
                disablewhen "{ en_level_path == 0 }"
                menu {
                    "point"     "Point"
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "owner_level_path" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "level_path_str"
                label   "Level Path"
                type    string
                default { "{world}/SubLevels/Generated" }
                disablewhen "{ en_level_path == 0 }"
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
                parmtag { "import_token" "level_path_str" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_bake_folder"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/1_Bake_Outputs.ds" }
            parmtag { "import_token" "en_bake_folder" }
        }
        groupcollapsible {
