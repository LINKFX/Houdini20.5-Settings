{
    name	selectedparms

    group {
        name    "folder3"
        label   "Main"

        parm {
            name    "en_mat_hole"
            label   "Enable"
            type    toggle
            default { "0" }
        }
        groupcollapsible {
            name    "grp_mat_hole"
            label   "Material Hole"
            parmtag { "group_default" "0" }
            parmtag { "sidefx::header_parm" "mat_hole_path" }
            parmtag { "sidefx::header_toggle" "en_mat_hole" }

            parm {
                name    "mat_hole_heading"
                label   "Heading"
                type    label
                default { "unreal_material_hole" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "mat_hole_help_heading"
                label   "Help"
                type    label
                default { "说明：指定用于 Landscape 洞（Hole）的材质资源路径（Content Path），用于标记被挖空区域。 \n示例：/Game/Materials/M_LandscapeHole → 实际写出 unreal_material_hole=/Game/Materials/M_LandscapeHole。 \n结果：UE 中可在地形使用该材质处理洞区域（通常配合 Masked 材质）。 \nOwner：Prim/Detail。 " }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_mat_hole"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_mat_hole == 0 }"
                menu {
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "mat_hole_path"
                label   "Content Path"
                type    string
                default { "/Game/Materials/M_LandscapeHole" }
                disablewhen "{ en_mat_hole == 0 }"
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_shared_actor"
            label   "Enable"
            type    toggle
            default { "0" }
        }
        groupcollapsible {
            name    "grp_shared_actor"
            label   "Shared Actor Name"
            parmtag { "group_default" "0" }
            parmtag { "sidefx::header_parm" "shared_actor_name" }
            parmtag { "sidefx::header_toggle" "en_shared_actor" }

            parm {
                name    "shared_actor_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_shared_actor_name" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "shared_actor_help_heading"
                label   "Help"
                type    label
                default { "说明：启用 Landscape Streaming Proxies 时，用于主/共享 Landscape Actor 的命名。支持字符串 Token（如 {hda_actor_name}）。 \n示例：{hda_actor_name}_SharedLandscape → 实际写出 unreal_landscape_shared_actor_name={hda_actor_name}_SharedLandscape。 \n结果：各 Tile Actor 会从该共享名读取/派生。 \nOwner：Point/Prim/Detail。 " }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_shared_actor"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_shared_actor == 0 }"
                menu {
                    "point"     "Point"
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "shared_actor_name"
                label   "Name"
                type    string
                default { "{hda_actor_name}_SharedLandscape" }
                disablewhen "{ en_shared_actor == 0 }"
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_layer_min"
            label   "Enable"
            type    toggle
            default { "0" }
        }
        groupcollapsible {
            name    "grp_layer_min"
            label   "Layer Min"
            parmtag { "group_default" "0" }
            parmtag { "sidefx::header_parm" "layer_min_val" }
            parmtag { "sidefx::header_toggle" "en_layer_min" }

            parm {
                name    "layer_min_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_layer_min" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "layer_min_help_heading"
                label   "Help"
                type    label
                default { "说明：将高度/权重值转换到 Landscape 时的最小阈值（归一化映射下界）。 \n示例：0 → 实际写出 unreal_landscape_layer_min=0。 \n结果：用于保证不同 Tile 以一致方式转换。 \nOwner：Point/Prim/Detail。 " }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_layer_min"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_layer_min == 0 }"
                menu {
                    "point"     "Point"
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "layer_min_val"
                label   "Value"
                type    float
                default { "0" }
                disablewhen "{ en_layer_min == 0 }"
                range   { 0 10 }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_layer_max"
            label   "Enable"
            type    toggle
            default { "0" }
        }
        groupcollapsible {
            name    "grp_layer_max"
            label   "Layer Max"
            parmtag { "group_default" "0" }
            parmtag { "sidefx::header_parm" "layer_max_val" }
            parmtag { "sidefx::header_toggle" "en_layer_max" }

            parm {
                name    "layer_max_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_layer_max" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "layer_max_help_heading"
                label   "Help"
                type    label
                default { "说明：将高度/权重值转换到 Landscape 时的最大阈值（归一化映射上界）。 \n示例：1 → 实际写出 unreal_landscape_layer_max=1。 \n结果：与最小阈值配合用于统一 Tile 的转换范围。 \nOwner：Point/Prim/Detail。 " }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_layer_max"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_layer_max == 0 }"
                menu {
                    "point"     "Point"
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "layer_max_val"
                label   "Value"
                type    float
                default { "1" }
                disablewhen "{ en_layer_max == 0 }"
                range   { 0 10 }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_section_size"
            label   "Enable"
            type    toggle
            default { "0" }
        }
        groupcollapsible {
            name    "grp_section_size"
            label   "Section Size"
            parmtag { "group_default" "0" }
            parmtag { "sidefx::header_parm" "section_size" }
            parmtag { "sidefx::header_toggle" "en_section_size" }

            parm {
                name    "section_size_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_section_size" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "section_size_help_heading"
                label   "Help"
                type    label
                default { "说明：设置 Landscape 的 Section 大小（如 63/127 等）。需与“Sections Per Component”配对设置。 \n示例：127 → 实际写出 unreal_landscape_section_size=127。 \n结果：影响地形组件的分割与渲染效率。 \nOwner：Prim。 " }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_section_size"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_section_size == 0 }"
                menu {
                    "prim"  "Prim"
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "section_size"
                label   "Size"
                type    integer
                default { "127" }
                disablewhen "{ en_section_size == 0 }"
                range   { 0 10 }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_sections_per_comp"
            label   "Enable"
            type    toggle
            default { "ch(\"en_section_size\")" }
        }
        groupcollapsible {
            name    "grp_sections_per_comp"
            label   "Sections Per Component"
            parmtag { "group_default" "0" }
            parmtag { "sidefx::header_parm" "sections_per_comp" }
            parmtag { "sidefx::header_toggle" "en_sections_per_comp" }

            parm {
                name    "sections_per_comp_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_sections_per_component" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "sections_per_comp_help_heading"
                label   "Help"
                type    label
                default { "说明：每个组件包含的 Section 数（如 1/2）。需与“Section Size”配对设置。 \n示例：2 → 实际写出 unreal_landscape_sections_per_component=2。 \n结果：共同决定组件分辨率与数量。 \nOwner：Prim。 " }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_sections_per_comp"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_sections_per_comp == 0 }"
                menu {
                    "prim"  "Prim"
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "sections_per_comp"
                label   "Count"
                type    integer
                default { "2" }
                disablewhen "{ en_sections_per_comp == 0 }"
                range   { 0 10 }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_unit_layer"
            label   "Enable"
            type    toggle
            default { "0" }
        }
        groupcollapsible {
            name    "grp_unit_layer"
            label   "Unit Mask"
            parmtag { "group_default" "0" }
            parmtag { "sidefx::header_toggle" "en_unit_layer" }

            parm {
                name    "unit_layer_heading"
                label   "Heading"
                type    label
                default { "unreal_unit_landscape_layer" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "unit_layer_help_heading"
                label   "Help"
                type    label
                default { "说明：以 0/1 单位区间解释掩码为 Landscape 图层（布尔化）。 \n示例：启用 → 实际写出 unreal_unit_landscape_layer=1。 \n结果：掩码值在阈值处截断为 0 或 1。 \nOwner：Prim/Detail。 " }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_unit_layer"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                default { "prim" }
                disablewhen "{ en_unit_layer == 0 }"
                menu {
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_nonweight_list"
            label   "Enable"
            type    toggle
            default { "0" }
        }
        groupcollapsible {
            name    "grp_nonweight_list"
            label   "Non-Weight Layers (List)"
            parmtag { "group_default" "0" }
            parmtag { "sidefx::header_parm" "nonweight_list_str" }
            parmtag { "sidefx::header_toggle" "en_nonweight_list" }

            parm {
                name    "nonweight_list_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_layer_nonweightblended" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "nonweight_list_help_heading"
                label   "Help"
                type    label
                default { "说明：以空格分隔的掩码名称集合，创建为非权重混合（Non-Weight Blended）图层。 \n示例：Road Decal → 实际写出 unreal_landscape_layer_nonweightblended=\"Road Decal\"。 \n结果：这些图层不参与权重归一，适合覆盖/贴花。 \nOwner：Prim/Detail。 " }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_nonweight_list"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_nonweight_list == 0 }"
                menu {
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "nonweight_list_str"
                label   "Mask Names"
                type    string
                default { "Road Decal" }
                disablewhen "{ en_nonweight_list == 0 }"
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_layer_info"
            label   "Enable"
            type    toggle
            default { "0" }
        }
        groupcollapsible {
            name    "grp_layer_info"
            label   "Layer Info Path"
            parmtag { "group_default" "0" }
            parmtag { "sidefx::header_parm" "layer_info_path" }
            parmtag { "sidefx::header_toggle" "en_layer_info" }

            parm {
                name    "layer_info_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_layer_info" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "layer_info_help_heading"
                label   "Help"
                type    label
                default { "说明：指定现有 LandscapeLayerInfo 资源路径，用于将掩码转换到对应图层。 \n示例：/Game/Landscape/LI_Road → 实际写出 unreal_landscape_layer_info=/Game/Landscape/LI_Road。 \n结果：使用指定 LayerInfo 对应的图层设置。 \nOwner：Prim。 " }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_layer_info"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_layer_info == 0 }"
                menu {
                    "prim"  "Prim"
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "layer_info_path"
                label   "Content Path"
                type    string
                default { "/Game/Landscape/LI_Road" }
                disablewhen "{ en_layer_info == 0 }"
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_noweightblend"
            label   "Enable"
            type    toggle
            default { "0" }
        }
        groupcollapsible {
            name    "grp_noweightblend"
            label   "NoWeightBlend"
            parmtag { "group_default" "0" }
            parmtag { "sidefx::header_toggle" "en_noweightblend" }

            parm {
                name    "noweightblend_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_layer_noweightblend" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "noweightblend_help_heading"
                label   "Help"
                type    label
                default { "说明：将图层的 LayerInfo 设为 NoWeightBlend（不参与权重归一），适合覆盖/贴花式图层。高于列表字段的优先级。 \n示例：启用 → 实际写出 unreal_landscape_layer_noweightblend=1。 \n结果：该图层不受其他权重图层影响。 \nOwner：Prim/Detail。 " }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_noweightblend"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                default { "prim" }
                disablewhen "{ en_noweightblend == 0 }"
                menu {
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_output_mode"
            label   "Enable"
            type    toggle
            default { "0" }
        }
        groupcollapsible {
            name    "grp_output_mode"
            label   "Output Mode"
            parmtag { "group_default" "0" }
            parmtag { "sidefx::header_toggle" "en_output_mode" }

            parm {
                name    "output_mode_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_output_mode" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "output_mode_help_heading"
                label   "Help"
                type    label
                default { "说明：切换为 Modify Edit Layer 输出模式（默认 Generate）。 \n示例：启用 → 实际写出 unreal_landscape_output_mode=1。 \n结果：对现有 Landscape 的 Edit Layer 进行修改而非新建。 \nOwner：Point/Prim/Detail。 " }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_output_mode"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                default { "prim" }
                disablewhen "{ en_output_mode == 0 }"
                menu {
                    "point"     "Point"
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_editlayer_name"
            label   "Enable"
            type    toggle
            default { "0" }
        }
        groupcollapsible {
            name    "grp_editlayer_name"
            label   "EditLayer Name"
            parmtag { "group_default" "0" }
            parmtag { "sidefx::header_parm" "editlayer_name_str" }
            parmtag { "sidefx::header_toggle" "en_editlayer_name" }

            parm {
                name    "editlayer_name_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_editlayer_name" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "editlayer_name_help_heading"
                label   "Help"
                type    label
                default { "说明：目标 Edit Layer 的名称。 \n示例：Landscape → 实际写出 unreal_landscape_editlayer_name=Landscape。 \n结果：将输出写入/创建到该命名的 Edit Layer。 \nOwner：Point/Prim/Detail。 " }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_editlayer_name"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_editlayer_name == 0 }"
                menu {
                    "point"     "Point"
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "editlayer_name_str"
                label   "Name"
                type    string
                default { "Landscape" }
                disablewhen "{ en_editlayer_name == 0 }"
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_editlayer_type"
            label   "Enable"
            type    toggle
            default { "0" }
        }
        groupcollapsible {
            name    "grp_editlayer_type"
            label   "EditLayer Type"
            parmtag { "group_default" "0" }
            parmtag { "sidefx::header_parm" "editlayer_type_mode" }
            parmtag { "sidefx::header_toggle" "en_editlayer_type" }

            parm {
                name    "editlayer_type_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_editlayer_type" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "editlayer_type_help_heading"
                label   "Help"
                type    label
                default { "说明：输出图层类型：0=Create New，1=Additive。 \n示例：Additive → 实际写出 unreal_landscape_editlayer_type=1。 \n结果：控制写入的图层是否在现有基础上相加。 \nOwner：Point/Prim/Detail。 " }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_editlayer_type"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_editlayer_type == 0 }"
                menu {
                    "point"     "Point"
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "editlayer_type_mode"
                label   "Type"
                type    ordinal
                default { "0" }
                disablewhen "{ en_editlayer_type == 0 }"
                menu {
                    "0" "Create New (0)"
                    "1" "Additive (1)"
                }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_editlayer_after"
            label   "Enable"
            type    toggle
            default { "0" }
        }
        groupcollapsible {
            name    "grp_editlayer_after"
            label   "EditLayer After"
            parmtag { "group_default" "0" }
            parmtag { "sidefx::header_parm" "editlayer_after_str" }
            parmtag { "sidefx::header_toggle" "en_editlayer_after" }

            parm {
                name    "editlayer_after_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_editlayer_after" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "editlayer_after_help_heading"
                label   "Help"
                type    label
                default { "说明：指定输出图层插入到目标 Landscape 的哪一图层之后。 \n示例：Base → 实际写出 unreal_landscape_editlayer_after=Base。 \n结果：用于调整图层堆叠顺序。 \nOwner：Point/Prim/Detail。 " }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_editlayer_after"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_editlayer_after == 0 }"
                menu {
                    "point"     "Point"
                    "prim"      "Prim"
                    "detail"    "Detail"
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "editlayer_after_str"
                label   "Layer Name"
                type    string
                default { "Base" }
                disablewhen "{ en_editlayer_after == 0 }"
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_editlayer_clear"
            label   "Enable"
            type    toggle
            default { "0" }
        }
        groupcollapsible {
            name    "grp_editlayer_clear"
            label   "Clear EditLayer"
            parmtag { "group_default" "0" }
            parmtag { "sidefx::header_toggle" "en_editlayer_clear" }

            parm {
                name    "editlayer_clear_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_editlayer_clear" }
