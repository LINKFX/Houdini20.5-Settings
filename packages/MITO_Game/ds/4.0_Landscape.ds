                type    label
                default { "unreal_landscape_spline_segment_meshX" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                parmtag { "import_token" "seg_mesh_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "seg_mesh_help"
                label   "Help"
                type    label
                default { "说明：为 Segment 指定一个静态网格和多个材质覆盖。\n- 属性模式：从数组属性读取，第一个元素是 Mesh 路径，后续是材质覆盖路径。\n- 数值模式：直接指定 Mesh 路径，并可添加多个材质覆盖。\n示例(属性)：来源 arr=[/Game/SM_Road, /Game/MI_Asphalt, /Game/MI_RoadEdge] →\n  unreal_landscape_spline_segment_mesh0=/Game/SM_Road\n  unreal_landscape_spline_segment_mesh0_material_override0=/Game/MI_Asphalt\n  unreal_landscape_spline_segment_mesh0_material_override1=/Game/MI_RoadEdge\n示例(数值)：Mesh=/Game/SM_Road + Overrides=/Game/MI_Asphalt。\n结果：Segment 使用指定 Mesh，并用材质覆盖替换槽。\nOwner：Point/Vertex/Prim。" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                parmtag { "import_token" "seg_mesh_help" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_seg_mesh"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_seg_mesh == 0 }"
                menu {
                    "point"     "Point"
                    "vertex"    "Vertex"
                    "prim"      "Prim"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                parmtag { "import_token" "owner_seg_mesh" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "seg_form_mode_mesh"
                label   "Form Mode"
                type    ordinal
                nolabel
                default { "value" }
                disablewhen "{ en_seg_mesh == 0 }"
                menu {
                    "attrib"    "Attribute"
                    "value"     "Value"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                parmtag { "import_token" "seg_form_mode_mesh" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "seg_mesh_from_pt"
                label   "Attribute From"
                type    string
                default { "" }
                disablewhen "{ en_seg_mesh == 0 } { owner_seg_mesh != point } { seg_form_mode_mesh != attrib }"
                hidewhen "{ owner_seg_mesh != point }"
                menutoggle {
                    [ " opmenu -l -a attribute ptdel " ]
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                parmtag { "import_token" "seg_mesh_from_pt" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "seg_mesh_from_vtx"
                label   "Attribute From"
                type    string
                default { "" }
                disablewhen "{ en_seg_mesh == 0 } { owner_seg_mesh != vertex } { seg_form_mode_mesh != attrib }"
                hidewhen "{ owner_seg_mesh != vertex }"
                menutoggle {
                    [ " opmenu -l -a attribute vtxdel " ]
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                parmtag { "import_token" "seg_mesh_from_vtx" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "seg_mesh_from_prim"
                label   "Attribute From"
                type    string
                default { "" }
                disablewhen "{ en_seg_mesh == 0 } { owner_seg_mesh != prim } { seg_form_mode_mesh != attrib }"
                hidewhen "{ owner_seg_mesh != prim }"
                menutoggle {
                    [ " opmenu -l -a attribute primdel " ]
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                parmtag { "import_token" "seg_mesh_from_prim" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "seg_mesh_val"
                label   "Mesh Path"
                type    string
                default { "/Game/SM_Road" }
                disablewhen "{ en_seg_mesh == 0 } { seg_form_mode_mesh != value }"
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                parmtag { "import_token" "seg_mesh_val" }
                parmtag { "script_callback_language" "python" }
            }
            multiparm {
                name    "seg_mesh_matovr_count"
                label    "Material Overrides"
                disablewhen "{ en_seg_mesh == 0 } { seg_form_mode_mesh != value }"
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                parmtag { "import_token" "seg_mesh_matovr_count" }

                parm {
                    name    "seg_mesh_matovr_val#"
                    label   "Material Path"
                    type    string
                    default { "/Game/MI_Asphalt" }
                    disablewhen "{ en_seg_mesh == 0 } { seg_form_mode_mesh != value }"
                    parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                    parmtag { "import_token" "seg_mesh_matovr_val#" }
                    parmtag { "script_callback_language" "python" }
                }
            }

        }

        parm {
            name    "en_seg_paint"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
            parmtag { "import_token" "en_seg_paint" }
            parmtag { "script_callback_language" "python" }
        }
        groupcollapsible {
            name    "grp_seg_paint"
            label   "Paint Layer Name"
            parmtag { "group_default" "0" }
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
            grouptag { "import_token" "grp_seg_paint:Paint Layer Name" }
            parmtag { "sidefx::header_parm" "seg_paint_str" }
            parmtag { "sidefx::header_toggle" "en_seg_paint" }

            parm {
                name    "seg_paint_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_spline_segment_paint_layer_name" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                parmtag { "import_token" "seg_paint_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "seg_paint_help"
                label   "Help"
                type    label
                default { "说明：指定 Segment 绘制到的 Paint Layer 名称。\n示例(属性)：来源 paint=Road → 写出 unreal_landscape_spline_segment_paint_layer_name=Road，paint 被移除。\n示例(数值)：直接设置 unreal_landscape_spline_segment_paint_layer_name=Road。\n结果：Spline Segment 会在 UE 中绘制到指定图层。\nOwner：Point/Vertex/Prim。" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                parmtag { "import_token" "seg_paint_help" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_seg_paint"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                joinnext
                default { "prim" }
                disablewhen "{ en_seg_paint == 0 }"
                menu {
                    "point"     "Point"
                    "vertex"    "Vertex"
                    "prim"      "Prim"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                parmtag { "import_token" "owner_seg_paint" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "seg_paint_str"
                label   "Layer Name"
                type    string
                default { "Road" }
                disablewhen "{ en_seg_paint == 0 }"
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                parmtag { "import_token" "seg_paint_str" }
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "en_seg_raise"
            label   "Enable"
            type    toggle
            default { "0" }
            parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
            parmtag { "import_token" "en_seg_raise" }
            parmtag { "script_callback_language" "python" }
        }
        groupcollapsible {
            name    "grp_seg_raise"
            label   "Raise Terrain"
            parmtag { "group_default" "0" }
            grouptag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
            grouptag { "import_token" "grp_seg_raise:Raise Terrain" }
            parmtag { "sidefx::header_toggle" "en_seg_raise" }

            parm {
                name    "seg_raise_heading"
                label   "Heading"
                type    label
                default { "unreal_landscape_spline_segment_raise_terrain" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                parmtag { "import_token" "seg_raise_heading" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "seg_raise_help"
                label   "Help"
                type    label
                default { "说明：是否在应用样条时抬高地形。\n示例：1 → 写出 unreal_landscape_spline_segment_raise_terrain=1。\n结果：Spline Segment 区域的地形被抬高。\nOwner：Point/Vertex/Prim。" }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                parmtag { "import_token" "seg_raise_help" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "owner_seg_raise"
                label   "Attribute Owner"
                type    ordinal
                nolabel
                default { "prim" }
                disablewhen "{ en_seg_raise == 0 }"
                menu {
                    "point"     "Point"
                    "vertex"    "Vertex"
                    "prim"      "Prim"
                }
                parmtag { "import_source" "$HOUDINI_USER_PREF_DIR/packages/MITO_Game/ds/4.4_Landscape_Splines_Segment.ds" }
                parmtag { "import_token" "owner_seg_raise" }
                parmtag { "script_callback_language" "python" }
            }
        }

    }


}